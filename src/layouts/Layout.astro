            playEventSound(ev as 'bus' | 'stop');
        });
        document.getElementById(`sound-upload-${ev}`)?.addEventListener('click', () => {
            const input = document.getElementById(`sound-file-${ev}`) as HTMLInputElement;
            if (input) {
                input.value = '';
                input.click();
            }
        });
        document.getElementById(`sound-file-${ev}`)?.addEventListener('change', (e: any) => {
            const file = e.target?.files?.[0];
            if (!file) return;
            if (file.size > MAX_CUSTOM_SIZE) {
                inAppAlert(t.settingsSoundTooBig, { durationMs: 5000 });
                return;
            }
            const reader = new FileReader();
            reader.onload = (event) => {
                const dataUri = event.target?.result as string;
                if (dataUri) {
                    setCustomSound(ev as 'bus' | 'stop', dataUri);
                    renderSoundsSettingsUI();
                    inAppAlert(lang === 'en' ? 'Custom sound saved' : 'Sonido personalizado guardado', { durationMs: 4000 });
                }
            };
            reader.readAsDataURL(file);
        });
        document.getElementById(`sound-remove-${ev}`)?.addEventListener('click', () => {
            setCustomSound(ev as 'bus' | 'stop', null);
            renderSoundsSettingsUI();
