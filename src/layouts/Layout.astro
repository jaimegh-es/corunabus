<script>
    import { tracking, getWalkHeadStart } from "../utils/tracking";
    import { readBusStops, resolveBusRoute } from "../utils/trackingRoute";
    import { API, isApiLoading, isApiCooldownActive } from "../services/api";
    import { storage } from "../utils/storage";
    import { getTranslations } from "../utils/i18n";
    import { inAppAlert } from "../utils/inAppAlert";
    import { getPosition } from "../utils/geolocation";
    import {
        isNativePlatform,
        getBgConfig,
        setBgConfig,
        requestBgAlertPermission,
        checkBgAlertPermission,
        startForegroundChecker,
        stopForegroundChecker,
        resetAlertState,
        startNativeBackgroundTracking,
        stopNativeBackgroundTracking,
    } from "../utils/backgroundAlerts";
    import { checkForUpdate as checkUpdateInfo, downloadAndInstall, autoCheckOnOpen, getLatestApkUrl, type UpdateInfo } from "../utils/autoUpdate";
    import { getPendingChangelog, markChangelogSeen } from "../utils/changelog";
    import { createIcons, X, Trash2, Plus, MapPin } from "lucide";
    import { playEventSound, getCustomSound, isCustomSoundSet, setCustomSound, MAX_CUSTOM_SIZE } from "../utils/sounds";
    import { Capacitor } from "@capacitor/core";
    import { App } from "@capacitor/app";
    import { notify } from "../utils/notify";
    import { LocalNotifications } from "@capacitor/local-notifications";

    const lang = document.documentElement.getAttribute('data-lang') || 'es';
    const t = getTranslations(lang);

    // Helper function to send notifications on both desktop and mobile (Android/Chrome ready)
    // Función auxiliar para enviar notificaciones en escritorio y móvil (lista para Android/Chrome)
    // Unified notification sender — native Android tray on Capacitor,
    // Service Worker / window.Notification on web.
    // Emisor unificado — bandeja nativa de Android en Capacitor,
    // Service Worker / window.Notification en web.
    async function sendNotification(title: string, options: any = {}): Promise<() => void> {
        return await notify(title, options.body || '', { silent: !!options.silent });
    }

    // Show persistent background tracking notification
    // Mostrar la notificación persistente de seguimiento en segundo plano
    function showBackgroundNotification() {
        const title = lang === 'en' ? 'Coruña Bus - Active tracking' : 'Coruña Bus - Seguimiento activo';
        const bodyText = lang === 'en' ? 'The app will stay active in the background to alert you about your stops.' : 'La app se mantendrá activa en segundo plano para avisarte de tus paradas.';
        if (isNativePlatform()) {
            // Persistent, silent native notification (id 424243, tagged for later dismissal)
            // Notificación nativa persistente y silenciosa (id 424243, marcada para poder cerrarla)
            LocalNotifications.schedule({
                notifications: [{
                    id: 424243,
                    title,
                    body: bodyText,
                    channelId: 'buscoruna-alerts',
                    schedule: { at: new Date(Date.now() + 50) },
                    ongoing: true,
                    silent: true,
                    actionTypeId: '',
                    extra: { source: 'buscoruna-bg' },
                } as any],
            }).catch(() => {});
            return;
        }
        sendNotification(title, {
            body: bodyText,
            tag: "tracking-bg",
            silent: true,
            icon: "/logo.png",
            badge: "/logo.png",
            requireInteraction: true
        });
    }

    // Close persistent background tracking notification
    // Cerrar la notificación de seguimiento en segundo plano
    function closeBackgroundNotification() {
        if (isNativePlatform()) {
            // Dismiss the persistent tracking notification on native
            // Descartar la notificación persistente en nativo
            LocalNotifications.getDeliveredNotifications().then((res: any) => {
                const ids = (res.notifications || [])
                    .filter((n: any) => n.extra?.source === 'buscoruna-bg')
                    .map((n: any) => n.id);
                if (ids.length) LocalNotifications.removeDeliveredNotifications({ notifications: ids });
            }).catch(() => {});
            return;
        }
        if ("serviceWorker" in navigator && Notification.permission === "granted") {
            navigator.serviceWorker.ready.then((registration) => {
                registration.getNotifications({ tag: "tracking-bg" }).then((notifications) => {
                    notifications.forEach(notification => notification.close());
                });
            });
        }
    }

    const globalLoader = document.getElementById("global-api-loader");

    function checkInitialLoading() {
        if (isApiLoading()) {
            globalLoader?.classList.add("active");
        }
    }

    window.addEventListener("api-loading-start", () => {
        globalLoader?.classList.add("active");
    });
    window.addEventListener("api-loading-end", () => {
        globalLoader?.classList.remove("active");
    });

    // Initialize state
    checkInitialLoading();

    // Check for app updates (native build only)
    // Comprobar actualizaciones de la app (solo build nativo)
    autoCheckOnOpen();

    // Show the changelog once per new app version (native and web)
    // Mostrar el changelog una vez por versión nueva (nativo y web)
    (async () => {
        try {
            let appVersion: string | null = null;
            if (isNativePlatform()) {
                const info = await App.getInfo();
                appVersion = info.version;
            } else {
                appVersion =
                    document.querySelector('meta[name="app-version"]')?.getAttribute('content') || null;
            }
            if (!appVersion) return;
            const entry = getPendingChangelog(appVersion);
            if (!entry) return;

            const modal = document.getElementById('changelog-modal');
            const titleEl = document.getElementById('changelog-title');
            const listEl = document.getElementById('changelog-items');
            if (!modal || !listEl) return;

            titleEl && (titleEl.textContent = `${t.changelogTitle} · v${entry.version}`);
            listEl.innerHTML = entry.items.map(i => `<li>${i}</li>`).join('');
            modal.style.display = 'flex';

            const close = () => {
                modal.style.display = 'none';
                markChangelogSeen(entry.version);
            };
            document.getElementById('changelog-ok')?.addEventListener('click', close);
            document.getElementById('changelog-close')?.addEventListener('click', close);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) close();
            });
        } catch (e) {
            console.warn('[Changelog] failed to show', e);
        }
    })();

    function updateLastRefreshTime() {
        const el = document.getElementById("last-update");
        if (el) {
            const now = new Date();
            const label = lang === 'en' ? 'Updated' : 'Actualizado';
            const locale = lang === 'en' ? 'en-US' : 'es-ES';
            el.innerHTML = `${label}<br><strong>${now.toLocaleTimeString(locale, { hour: "2-digit", minute: "2-digit", second: "2-digit" })}</strong>`;
        }
    }

    const refreshBtn = document.getElementById("global-refresh-btn");
    refreshBtn?.addEventListener("click", () => {
        refreshBtn.classList.add("spinning");
        // Dispatch a global event that other components can listen to
        window.dispatchEvent(new CustomEvent("request-refresh"));

        setTimeout(() => {
            refreshBtn.classList.remove("spinning");
            updateLastRefreshTime();
        }, 1000);
    });

    // Tracking logic
    let trackingInterval: any = null;
    let isUpdating = false;
    // Bumped every time tracking is stopped. In-flight updates snapshot the
    // value when they start and discard their results if it changed meanwhile,
    // so "stop tracking" takes effect instantly instead of after the query.
    let trackingGeneration = 0;
    // Hard cap for a single UI update. Even if some awaited promise stalls, the
    // tracking loop and the "stop tracking" button must never lock up.
    const MAX_TRACKING_UPDATE_MS = 30000;

    // Cache + throttle for the expensive func=2 (full line info) ETA fallback.
    let lastLineInfoCheck = 0;
    let lineInfoCache = { foundInLine: false, stopsLeft: -1, etaMins: -1, asOf: 0 };
    // Real-time per-stop travel estimate (seconds) derived from observed bus
    // position changes (func=2). Used by the phase-2 fallback so the remaining
    // time keeps being recalculated from real data instead of a fixed guess.
    let lastBusPosTime = 0;
    let lastBusStopIdx = -1;
    let avgSecPerStop: number | null = null;
    // Phase 1: whether the tracked bus has been observed approaching the origin
    // stop at least once. Avoids a premature board-transition when a far bus is
    // momentarily not listed in the stop's arrivals.
    let phase1BusSeen = false;
    // Phase 2 ('toDest') termination helpers: remember the last destination
    // ETA observed and how many consecutive polls the bus is missing from the
    // destination feed, so arrival is detected even when the feed drops the
    // bus right at/after the stop (the old code searched forever).
    // Ayudas de finalización de la fase 2: recuerdan la última ETA de destino
    // observada y las poll consecutivas sin el bus para detectar la llegada
    // aunque el feed deje de listarlo justo en/después de la parada.
    let lastDestObserved = -1;
    let destGoneStreak = 0;
    // Consecutive func=2 polls that no longer list the tracked bus ANYWHERE on
    // its line. The line info always reports every bus in service, so two polls
    // without it mean the bus left service (terminus, out of service) and the
    // journey is over: it guarantees tracking always ends on its own, even when
    // neither the destination feed nor the route match can decide it (variants,
    // a destination the bus serves from a different route, ...).
    let lineBusMissingStreak = 0;
    // Hard limit for a single journey. Every arrival path (the destination feed,
    // the live position, the bus leaving the line) has a way of missing, and a
    // tracking bar that never goes away is worse than one that stops early: this
    // long after the start the journey is over whatever the feeds say.
    // Límite duro del viaje. Todas las vías de llegada pueden fallar, y una barra
    // que no se retira es peor que una que se retira antes: pasado este tiempo el
    // viaje ha acabado digan lo que digan los feeds.
    const MAX_JOURNEY_MS = 90 * 60 * 1000;
    let journeyStartedAt = 0;
    let journeySignature = "";

    function checkJourneyTimeLimit(info: any) {
        const signature = `${info.busId}|${info.lineId}|${info.originStopId}|${info.destinationStopId}`;
        if (signature !== journeySignature) {
            journeySignature = signature;
            journeyStartedAt = Date.now();
        }
        if (!journeyStartedAt) {
            journeyStartedAt = Date.now();
            return;
        }
        if (Date.now() - journeyStartedAt > MAX_JOURNEY_MS) {
            finishTracking(t.trackingFinishedTitle, t.trackingFinishedBody);
        }
    }

    // Re-render the tracking bar right after a phase transition (the current
    // update is still holding `isUpdating`, so a plain call would be skipped).
    function scheduleTrackingRefresh(ms = 1000) {
        setTimeout(() => {
            if (!isUpdating) updateTrackingUI();
        }, ms);
    }

    // Shows a destination ETA in the tracking bar (real-time "remaining" value).
    function renderDestEta(time: number) {
        document.getElementById("track-eta-val")!.textContent = time.toString();
        const arrivalTime = new Date(Date.now() + time * 60000);
        let timeStr = "--:--";
        try {
            timeStr = arrivalTime.toLocaleTimeString(lang === 'en' ? 'en-US' : 'es-ES', {
                hour: "2-digit",
                minute: "2-digit",
            });
        } catch (e) {
            /* ignore invalid date */
        }
        document.getElementById("track-status")!.textContent =
            time === 0
                ? t.trackingArrivingDest
                : `${t.trackingPhaseToDest}: ${timeStr}`;
    }

    // Ends tracking on arrival: notifies the user, then clears everything so
    // the poller, GPS monitor, keep-awake silence and the persistent background
    // notification stop (saving battery).
    function finishTracking(title: string, body: string) {
        if (!tracking.get()) return;
        sendNotification(title, {
            body,
            requireInteraction: false,
            icon: "/logo.png",
            badge: "/logo.png"
        });
        inAppAlert(`${title}\n${body}`, { durationMs: 10000 });
        // Take effect immediately: bump the generation so any in-flight update
        // discards its results, then clear tracking (the tracking-updated
        // handler stops the GPS monitor, silence playback and native bg task).
        trackingGeneration++;
        tracking.clear();
    }

    // --- Journey auto-end after the get-off alert ---
    // Fin automático del viaje tras el aviso de bajada.
    // One minute after the "press the stop button" alert is emitted the
    // journey is over from the user's point of view: stop tracking on its
    // own (dismisses the persistent notification and stops every poller)
    // WITHOUT waiting for the user to open the app to confirm arrival.
    // Ends silently: no system notification, only a small in-app note (we
    // can't verify the actual arrival, so we never claim it).
    // Un minuto después de emitir el aviso de "pulsa el botón de parada" el
    // viaje termina: el seguimiento se detiene solo (cierra la notificación
    // persistente y todos los sondeos) SIN esperar a que el usuario abra la
    // app y confirme la llegada. Termina en silencio: sin notificación de
    // sistema, solo un aviso discreto en la app.
    let journeyAutoEndTimer: ReturnType<typeof setTimeout> | null = null;
    let journeyAutoEndGen = -1;

    function fireJourneyAutoEnd(gen: number) {
        journeyAutoEndTimer = null;
        if (gen !== trackingGeneration || !tracking.get()) return;
        trackingGeneration++;
        const popup = document.getElementById("gps-alert-popup");
        if (popup) popup.style.display = "none";
        inAppAlert(t.trackingFinishedBody, { durationMs: 6000 });
        tracking.clear();
    }

    function scheduleJourneyAutoEnd() {
        if (journeyAutoEndTimer) return;
        journeyAutoEndGen = trackingGeneration;
        journeyAutoEndTimer = setTimeout(() => fireJourneyAutoEnd(journeyAutoEndGen), 60000);
    }

    function cancelJourneyAutoEnd() {
        if (journeyAutoEndTimer) {
            clearTimeout(journeyAutoEndTimer);
            journeyAutoEndTimer = null;
        }
    }

    // Phase 1 ('toStop'): count down, in real time, until the bus reaches the
    // boarding/origin stop. This integrates the old "arrival alert" button,
    // including the walking head-start from the active saved location.
    async function updatePhaseToStop(info: any, gen: number) {
        const etaAlertEnabled = localStorage.getItem('buscoruna_eta_alert_enabled') !== 'false';
        const etaAlertTriggered = localStorage.getItem('buscoruna_eta_alert_triggered') === 'true';
        // Walking head-start from the active saved departure location, with a
        // storage fallback so flows that don't snapshot it (bus tracker / trip
        // planner) still alert with enough margin to leave on time.
        const headStart = getWalkHeadStart(info);
        const walkMins = headStart.walkMinutes;
        const locName = headStart.locationName;
        // "Alert only" mode: the user asked to be notified when the bus reaches
        // this stop, without a destination. The journey ends on arrival.
        // Modo "solo aviso": el usuario solo quiere que le avisen de la llegada
        // a esta parada. El seguimiento acaba en cuanto llega el bus.
        const alertOnly = info.destinationStopId === info.originStopId;
        // Head-start (walking minutes) or the configured ETA lead, whichever is more in advance.
        const cfgThreshold = parseInt(localStorage.getItem('buscoruna_eta_alert_threshold') || '2', 10);
        const threshold = walkMins > 0 ? walkMins : (isNaN(cfgThreshold) ? 2 : cfgThreshold);

        const data = await API.getStopArrivals(info.originStopId);
        if (gen !== trackingGeneration || !tracking.get()) return;

        let found = false;
        let waitTime: number | null = null;
        if (data && data.resultado === "OK" && data.buses && Array.isArray(data.buses.lineas)) {
            for (const l of data.buses.lineas) {
                if (l.linea.toString() !== info.lineId.toString()) continue;
                if (!Array.isArray(l.buses)) continue;
                const b = l.buses.find(
                    (bus: any) => bus.bus && bus.bus.toString() === info.busId.toString(),
                );
                if (!b) continue;
                found = true;
                let t = typeof b.tiempo === "number" ? b.tiempo : parseInt(b.tiempo);
                if (isNaN(t)) t = 0; // ">>>", "PRX", etc.
                waitTime = t;
                break;
            }
        }

        // The bus is no longer reported at the origin stop: it already arrived
        // (or passed). Board and switch to phase 2 (remaining to destination).
        // Only do this once we have actually observed the bus approaching; a
        // bus that is simply not listed yet keeps us waiting.
        if (!found || waitTime === null) {
            if (phase1BusSeen) {
                if (alertOnly) {
                    // "Alert only" journey (no destination): the bus reached (or
                    // passed) the stop, so the journey ends here. Ending avoids a
                    // never-ending phase 2 that searches the same stop forever.
                    // Modo "solo aviso": el bus llegó (o pasó) a la parada, el
                    // viaje acaba para no quedarse buscando sin fin.
                    finishTracking(
                        lang === 'en' ? '🚌 Your bus has arrived' : '🚌 Tu autobús ha llegado',
                        lang === 'en'
                            ? 'Arrival alert finished. Tracking stopped to save battery.'
                            : 'Aviso finalizado. Se ha detenido el seguimiento para ahorrar batería.'
                    );
                } else {
                    tracking.patch({ phase: 'toDest' });
                    scheduleTrackingRefresh();
                    inAppAlert(t.trackingBoardNow, { durationMs: 6000 });
                }
            } else {
                document.getElementById("track-status")!.textContent =
                    t.trackingSearchingBus;
                document.getElementById("track-eta-val")!.textContent = "--";
            }
            return;
        }
        phase1BusSeen = true;

        // Integrated arrival/departure alert: notify with the head-start so the
        // user leaves the saved location on time.
        if (etaAlertEnabled && !etaAlertTriggered && waitTime <= threshold) {
            localStorage.setItem('buscoruna_eta_alert_triggered', 'true');
            const hasLocation = walkMins > 0 && !!locName;
            const notifyBody = hasLocation
                ? t.trackingLeaveNow.replace('{bus}', info.busId).replace('{n}', String(waitTime)).replace('{loc}', locName)
                : t.trackingLeaveNowNoLoc.replace('{bus}', info.busId).replace('{n}', String(waitTime));

            sendNotification(lang === 'en' ? '🚌 Your bus is arriving!' : '🚌 ¡Tu autobús está llegando!', {
                body: notifyBody,
                requireInteraction: true,
                icon: "/logo.png",
                badge: "/logo.png"
            });

            // Play sound and vibration FIRST, before any UI, so the user hears it immediately.
            if (navigator.vibrate) navigator.vibrate([200, 100, 200, 100, 200]);
            playEventSound('bus');

            inAppAlert(`🔔 ${notifyBody}`, { durationMs: 10000 });
        }

        // The bus reached the stop. In "alert only" mode (no destination) the
        // journey is finished: the user only asked to be notified of the
        // arrival. Otherwise, board and switch to phase 2.
        if (waitTime <= 0) {
            if (alertOnly) {
                finishTracking(
                    lang === 'en' ? '🚌 Your bus has arrived' : '🚌 Tu autobús ha llegado',
                    lang === 'en'
                        ? 'Arrival alert finished. Tracking stopped to save battery.'
                        : 'Aviso finalizado. Se ha detenido el seguimiento para ahorrar batería.'
                );
            } else {
                tracking.patch({ phase: 'toDest' });
                scheduleTrackingRefresh();
                inAppAlert(t.trackingBoardNow, { durationMs: 6000 });
            }
            return;
        }

        document.getElementById("track-eta-val")!.textContent = waitTime.toString();
        const arrivalTime = new Date(Date.now() + waitTime * 60000);
        let timeStr = "--:--";
        try {
            timeStr = arrivalTime.toLocaleTimeString(lang === 'en' ? 'en-US' : 'es-ES', {
                hour: "2-digit",
                minute: "2-digit",
            });
        } catch (e) {
            /* ignore invalid date */
        }
        document.getElementById("track-status")!.textContent =
            `${t.trackingPhaseToStop}: ${timeStr}`;
    }

    // Phase 2 ('toDest'): count down the real-time remaining time to the
    // destination. It is recalculated from live per-stop data (func=0 at the
    // destination stop); when the bus is not reported there yet it uses the
    // live bus position (func=2) plus a real-time per-stop travel average.
    async function updatePhaseToDest(info: any, gen: number) {
        // Step 1: real-time ETA at the destination stop.
        const data = await API.getStopArrivals(info.destinationStopId);
        if (gen !== trackingGeneration || !tracking.get()) return;

        let busFoundAtStop = false;
        let targetBus: any = null;
        if (data && data.resultado === "OK" && data.buses && Array.isArray(data.buses.lineas)) {
            for (const l of data.buses.lineas) {
                if (!Array.isArray(l.buses)) continue;
                const b = l.buses.find(
                    (bus: any) => bus.bus && bus.bus.toString() === info.busId.toString(),
                );
                if (b) {
                    targetBus = b;
                    busFoundAtStop = true;
                    break;
                }
            }
        }

        if (busFoundAtStop && targetBus) {
            let time = typeof targetBus.tiempo === "number" ? targetBus.tiempo : parseInt(targetBus.tiempo);
            if (isNaN(time)) time = 0;
            lastDestObserved = time;
            destGoneStreak = 0;
            renderDestEta(time);
            // The journey ends when the bus reaches the stop, not when it is
            // still a couple of minutes away: ending on "≤2 min" left the user a
            // "tracking stopped" notice a minute before arriving, with the
            // notifications already gone. It was needed while a bus missing from
            // this feed had no other way to end the trip; the live position below
            // and the bus leaving the line cover that now.
            // El viaje acaba cuando el bus llega a la parada, no cuando aún le
            // quedan un par de minutos: así el aviso de "seguimiento finalizado"
            // salía un minuto antes de llegar y sin notificaciones. Hacía falta
            // mientras un bus ausente de este feed no tenía otra vía de acabar.
            if (time <= 0) {
                finishTracking(t.trackingFinishedTitle, t.trackingFinishedBody);
            }
            return;
        }

        // The destination feed stopped reporting the bus right after it was
        // within ~1 min of the stop: it arrived (and departed) or is parked at
        // the terminus. Finish after two consecutive missed polls so a
        // transient API gap doesn't end the tracking early.
        // El feed de destino deja de listar el bus justo cuando estaba a ~1 min:
        // llegó (y salió) o está en la cabecera. Acabamos tras dos polls
        // consecutivas sin el bus para no cortar por un fallo puntual de la API.
        if (lastDestObserved >= 0 && lastDestObserved <= 1) {
            destGoneStreak++;
            if (destGoneStreak >= 2) {
                finishTracking(t.trackingFinishedTitle, t.trackingFinishedBody);
                return;
            }
        } else {
            destGoneStreak = 0;
        }

        // Step 2: bus not reported at the destination yet -> live position
        // (func=2) + real-time per-stop average. Throttled to once a minute.
        const cached = lineInfoCache;
        const stale = Date.now() - cached.asOf >= 60000;
        let foundInLine = cached.foundInLine;
        let stopsLeft = cached.stopsLeft;
        let etaMins = cached.etaMins;

        if (stale) {
            lastLineInfoCheck = Date.now();
            foundInLine = false;
            stopsLeft = -1;
            etaMins = -1;
            try {
                const lineData = await API.getLineInfo(info.lineId);
                if (gen !== trackingGeneration || !tracking.get()) return;

                const catalog = storage.getCatalog();
                // A usable answer: every bus in service is listed, so a bus
                // missing from all of them is out of service (terminus, low
                // service) and the journey is over. Two consecutive polls, so a
                // transient gap doesn't end it early. This is what guarantees
                // tracking always ends on its own, even when neither the
                // destination feed nor the routes can decide it.
                // Una respuesta utilizable: se listan todos los buses en
                // servicio, así que un bus que no aparece en ninguno acabó el
                // recorrido. Dos polls seguidas, para no cortar por un fallo
                // puntual. Es lo que garantiza que el seguimiento siempre acabe.
                const lineDataOk = !!(
                    lineData &&
                    Array.isArray(lineData.paradas) &&
                    lineData.paradas.length > 0 &&
                    (lineData.resultado === 'OK' || !lineData.resultado)
                );

                // Where the bus is right now, and the direction it travels in.
                const { sentido, stops } = readBusStops(lineData, info.busId);

                if (stops.length > 0) {
                    lineBusMissingStreak = 0;
                } else if (lineDataOk) {
                    lineBusMissingStreak++;
                    if (lineBusMissingStreak >= 2) {
                        lineBusMissingStreak = 0;
                        lastDestObserved = 0;
                        destGoneStreak = 0;
                        finishTracking(t.trackingFinishedTitle, t.trackingFinishedBody);
                        return;
                    }
                }

                if (stops.length > 0 && catalog) {
                    const line = catalog.actualizacion.lineas.find(
                        (l: any) => l.id.toString() === info.lineId.toString(),
                    );
                    const decision = resolveBusRoute(
                        Array.isArray(line?.rutas) ? line.rutas : [],
                        sentido,
                        stops,
                        info.destinationStopId,
                    );

                    if (decision.kind === 'past' || decision.kind === 'arrived') {
                        // The bus has gone through the destination stop (or is
                        // standing on it): the journey is over.
                        lastDestObserved = 0;
                        destGoneStreak = 0;
                        lineBusMissingStreak = 0;
                        finishTracking(t.trackingFinishedTitle, t.trackingFinishedBody);
                        return;
                    }

                    if (decision.kind === 'ahead') {
                        stopsLeft = decision.stopsLeft;
                        foundInLine = true;
                        const bIdx = decision.busIndex;

                        // Keep a per-stop travel average from real
                        // observations of the bus moving.
                        const now = Date.now();
                        if (lastBusStopIdx !== -1 && lastBusStopIdx !== bIdx) {
                            const elapsedSec = (now - lastBusPosTime) / 1000;
                            const moved = Math.abs(bIdx - lastBusStopIdx);
                            if (elapsedSec > 0 && moved > 0) {
                                const secPerStop = elapsedSec / moved;
                                avgSecPerStop = avgSecPerStop === null
                                    ? secPerStop
                                    : avgSecPerStop * 0.7 + secPerStop * 0.3;
                            }
                        }
                        lastBusPosTime = now;
                        lastBusStopIdx = bIdx;

                        const defaultSecPerStop = 150;
                        const perStop = avgSecPerStop ?? defaultSecPerStop;
                        etaMins = Math.max(1, Math.round((stopsLeft * perStop) / 60));
                    }
                }
            } catch (lineErr) {
                // Ignore transient failures on the throttled fallback.
                foundInLine = false;
                stopsLeft = -1;
                etaMins = -1;
            }
            lineInfoCache = { foundInLine, stopsLeft, etaMins, asOf: Date.now() };
        }

        // Tracking may have been stopped while the fallback was running.
        if (gen !== trackingGeneration || !tracking.get()) return;

        if (foundInLine) {
            document.getElementById("track-eta-val")!.textContent = etaMins.toString();
            document.getElementById("track-status")!.textContent =
                `~${stopsLeft} ${t.trackingStopsAway}`;
        } else {
            document.getElementById("track-status")!.textContent =
                t.trackingSearchingBus;
            document.getElementById("track-eta-val")!.textContent = "--";
        }
    }

    async function updateTrackingUI() {
        if (isUpdating) return;
        const info = tracking.get();
        const bar = document.getElementById("tracking-bar");
        if (!bar) return;

        if (!info) {
            bar.style.display = "none";
            phase1BusSeen = false;
            lastDestObserved = -1;
            destGoneStreak = 0;
            lineBusMissingStreak = 0;
            journeyStartedAt = 0;
            journeySignature = "";
            if (trackingInterval) {
                clearInterval(trackingInterval);
                trackingInterval = null;
            }
            return;
        }

        isUpdating = true;
        const gen = trackingGeneration;
        bar.style.display = "block";
        document.getElementById("track-bus-id")!.textContent = info.busId;
        checkJourneyTimeLimit(info);
        if (!tracking.get()) {
            isUpdating = false;
            return;
        }

        // Global circuit breaker open: pause network polling, keep the bar alive.
        if (isApiCooldownActive()) {
            document.getElementById("track-status")!.textContent =
                t.trackingConnectionError;
            document.getElementById("track-eta-val")!.textContent = "--";
            isUpdating = false;
            if (!trackingInterval) {
                trackingInterval = setInterval(updateTrackingUI, 60000);
            }
            return;
        }

        const catalog = storage.getCatalog();
        let destStopName = info.destinationName || info.destinationStopId.toString();
        if (catalog) {
            const destStop = catalog.paradas[info.destinationStopId];
            destStopName = destStop?.nombre || destStopName;
        }

        // Unified tracking label: phase 1 waits at the boarding stop (counting
        // until the bus arrives), phase 2 travels towards the destination.
        const trackTitleEl = document.querySelector("#tracking-bar .tracking-text strong");
        const phase = info.phase || 'toStop';
        if (trackTitleEl) {
            if (phase === 'toStop') {
                trackTitleEl.innerHTML = `${t.trackingBarWaiting} <span id="track-dest-name">${destStopName}</span>`;
            } else {
                trackTitleEl.innerHTML = `${t.trackingBarDest} <span id="track-dest-name">${destStopName}</span>`;
            }
        } else {
            const destSpan = document.getElementById("track-dest-name");
            if (destSpan) destSpan.textContent = destStopName;
        }

        // Recalculate ETA
        // Watchdog: force-release isUpdating if this update ever runs past the
        // cap, so "stop tracking" and future refreshes can't be blocked forever.
        const watchdog = setTimeout(() => {
            isUpdating = false;
        }, MAX_TRACKING_UPDATE_MS);
        try {
            if (phase === 'toStop') {
                await updatePhaseToStop(info, gen);
            } else {
                await updatePhaseToDest(info, gen);
            }
            // On arrival the flow finishes itself (tracking.clear()), so a
            // fresh get() tells us whether we still need to keep polling.
            if (!tracking.get()) return;
        } catch (err) {
            console.warn("Failed to update tracking ETA", err);
            document.getElementById("track-status")!.textContent =
                t.trackingConnectionError;
        } finally {
            clearTimeout(watchdog);
            isUpdating = false;
        }

        if (!trackingInterval && tracking.get()) {
            trackingInterval = setInterval(updateTrackingUI, 60000);
        }
    }

    // Initialize tracking UI immediately on load
    if (
        document.readyState === "complete" ||
        document.readyState === "interactive"
    ) {
        updateTrackingUI();
    } else {
        window.addEventListener("DOMContentLoaded", updateTrackingUI);
    }

    // Update when tracking is updated globally
    window.addEventListener("tracking-updated", () => {
        updateTrackingUI();
    });

    document.getElementById("stop-tracking")?.addEventListener("click", () => {
        // Take effect immediately: bump the generation so any in-flight update
        // discards its results, hide the bar and kill the poller right away.
        trackingGeneration++;
        const bar = document.getElementById("tracking-bar");
        if (bar) bar.style.display = "none";
        if (trackingInterval) {
            clearInterval(trackingInterval);
            trackingInterval = null;
        }
        tracking.clear();
    });

    window.addEventListener("request-refresh", () => {
        updateTrackingUI();
    });

    // Modal logic for fallback
    // "Cambiar destino": la lista de paradas se construye desde el catálogo
    // local (fiable, sin red) y la posición actual del bus (func=2) se usa solo
    // como filtro de mejor esfuerzo. Antes dependía de que la llamada func=2
    // tuviera respuesta válida y del catálogo, por eso fallaba siempre.
    document
        .getElementById("edit-tracking-dest")
        ?.addEventListener("click", async () => {
            const info = tracking.get();
            if (!info) return;

            const modal = document.getElementById("global-destination-modal")!;
            const list = document.getElementById("global-stops-list-modal")!;
            const lineNameEl = document.getElementById("modal-line-name")!;

            modal.style.display = "flex";
            list.innerHTML = '<div class="small">Cargando paradas...</div>';

            // Catálogo local primero; si la página aún no lo cargó, lo pedimos.
            let catalog = storage.getCatalog();
            if (!catalog) {
                try {
                    const fetched = await API.getCatalog();
                    if (fetched) {
                        catalog = fetched;
                        storage.setCatalog(fetched);
                    }
                } catch (err) {
                    catalog = null;
                }
            }

            try {
                const line = catalog?.actualizacion?.lineas?.find(
                    (l: any) => l.id.toString() === info.lineId.toString(),
                );
                if (!catalog || !line || !Array.isArray(line.rutas)) {
                    list.innerHTML =
                        '<div class="small">No se pudieron cargar las paradas de esta línea.</div>';
                    return;
                }
                lineNameEl.textContent = line.lin_comer || info.lineId.toString();

                // Todas las paradas de la línea (sin duplicados), en orden de ruta.
                const allStopIds: number[] = [];
                line.rutas.forEach((r: any) => {
                    if (!Array.isArray(r.paradas)) return;
                    r.paradas.forEach((sId: any) => {
                        const n = parseInt(sId);
                        if (!allStopIds.includes(n)) allStopIds.push(n);
                    });
                });

                // Mejor esfuerzo: localizar el bus en la línea (func=2) para
                // listar solo las paradas que le quedan por delante.
                let currentBusStopId: number | null = null;
                try {
                    const lineData = await API.getLineInfo(info.lineId);
                    if (lineData && Array.isArray(lineData.paradas)) {
                        for (const dir of lineData.paradas) {
                            if (!Array.isArray(dir.paradas)) continue;
                            for (const p of dir.paradas) {
                                if (
                                    Array.isArray(p.buses) &&
                                    p.buses.some(
                                        (b: any) =>
                                            b.bus &&
                                            b.bus.toString() ===
                                                info.busId.toString(),
                                    )
                                ) {
                                    currentBusStopId = parseInt(
                                        p.id.toString(),
                                    );
                                    break;
                                }
                            }
                            if (currentBusStopId) break;
                        }
                    }
                } catch (err) {
                    // Si func=2 falla, se listan todas las paradas de la línea.
                }

                // Orden de muestra:
                // 1) Si sabemos dónde está el bus, solo las paradas posteriores.
                // 2) Si no, las paradas posteriores a la parada de origen en la
                //    ruta que contiene el destino actual (preserva el sentido).
                // 3) Si no aplica, todas las paradas de la línea.
                let ordered: number[] = allStopIds;
                if (currentBusStopId) {
                    const pos = allStopIds.indexOf(currentBusStopId);
                    if (pos !== -1) ordered = allStopIds.slice(pos + 1);
                } else {
                    const route = line.rutas.find((r: any) => {
                        const ids = (r.paradas || []).map((p: any) => parseInt(p));
                        return (
                            ids.includes(parseInt(info.originStopId)) &&
                            ids.includes(parseInt(info.destinationStopId))
                        );
                    });
                    if (route) {
                        const ids = route.paradas.map((p: any) => parseInt(p));
                        const originIdx = ids.indexOf(parseInt(info.originStopId));
                        if (originIdx !== -1) ordered = ids.slice(originIdx + 1);
                    }
                }

                list.innerHTML = ordered
                    .map((sId) => {
                        const s = catalog.paradas[sId];
                        return `
            <div class="modal-list-item" data-stop="${sId}">
              <strong>${s?.nombre || sId}</strong>
              <small>Parada ${sId}</small>
            </div>
          `;
                    })
                    .join("");

                list.querySelectorAll(".modal-list-item").forEach(
                    (item) => {
                        item.addEventListener("click", () => {
                            const newDestId = parseInt(
                                item.getAttribute("data-stop")!,
                            );
                            const currentInfo = tracking.get();
                            if (currentInfo) {
                                // destinationName undefined -> se re-resuelve
                                // con el catálogo al refrescar la barra.
                                tracking.set({
                                    ...currentInfo,
                                    destinationStopId: newDestId,
                                    destinationName: undefined,
                                });
                            }
                            modal.style.display = "none";
                        });
                    },
                );
            } catch (err) {
                list.innerHTML =
                    '<div class="small">Error al conectar con el servidor.</div>';
            }
        });

    document
        .getElementById("close-global-modal")
        ?.addEventListener("click", () => {
            document.getElementById("global-destination-modal")!.style.display =
                "none";
        });

    // Auto refresh every 60 seconds
    setInterval(() => {
        window.dispatchEvent(new CustomEvent("request-refresh"));
        updateLastRefreshTime();
    }, 60000);

    // Initial time
    updateLastRefreshTime();

    // Share functionality
    document
        .getElementById("share-app-btn")
        ?.addEventListener("click", async () => {
            if (navigator.share) {
                try {
                    await navigator.share({
                        title: "Coruña Bus",
                        text: "¡Mira esta app para moverte por Coruña en bus!",
                        url: window.location.origin,
                    });
                } catch (err) {
                    console.error("Error sharing:", err);
                }
            } else {
                // Fallback: copy to clipboard
                navigator.clipboard.writeText(window.location.origin);
                alert(
                    "Enlace copiado al portapapeles. ¡Gracias por compartir!",
                );
            }
        });

    // GPS Alert Stop Warning & Background Keep-Awake features (bilingual comments)
    // Funcionalidad de aviso de parada por GPS, aviso de llegada de bus y ejecución en segundo plano
    let gpsInterval: any = null;
    let audioContext: AudioContext | null = null;
    let silenceNode: GainNode | null = null;

    function getDistance(lat1: number, lon1: number, lat2: number, lon2: number) {
        const R = 6371000; // meters
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                  Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                  Math.sin(dLon/2) * Math.sin(dLon/2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

    // Resolve the stop immediately before the destination stop in the route.
    // The destination alone disambiguates the direction: among the routes that
    // contain it, pick the one where it sits closest to the end (that is the
    // direction the bus is travelling in) and return its predecessor.
    // Obtener la parada inmediatamente anterior a la parada de destino en la
    // ruta. El destino basta para saber el sentido: de las rutas que lo
    // contienen, elige la que lo tenga más cerca del final (el sentido real
    // del bus) y devuelve la parada anterior.
    function getPreviousStop(lineId: number, destId: number, catalog: any) {
        const line = catalog.actualizacion.lineas.find(
            (l: any) => l.id.toString() === lineId.toString()
        );
        if (!line || !Array.isArray(line.rutas)) return null;

        const sDestId = destId.toString();

        let bestStopId: any = null;
        let bestScore = Infinity;
        for (const route of line.rutas) {
            if (!Array.isArray(route.paradas)) continue;
            const dIdx = route.paradas.findIndex((p: any) => p.toString() === sDestId);
            if (dIdx <= 0) continue;
            const score = route.paradas.length - dIdx; // lower = dest nearer the end
            if (score < bestScore) {
                bestScore = score;
                bestStopId = route.paradas[dIdx - 1];
            }
        }
        return bestStopId ? catalog.paradas[bestStopId] : null;
    }

    // Main interval check function to check GPS location against route stops
    // Función de verificación periódica del GPS contra las paradas de la ruta
    function checkGPSAlert() {
        const info = tracking.get();
        if (!info) {
            stopGPSMonitor();
            return;
        }

        if (localStorage.getItem('buscoruna_gps_alert_triggered') === 'true') {
            return; // Already notified for this journey
        }

        const catalog = storage.getCatalog();
        if (!catalog) return;

        const destStop = catalog.paradas[info.destinationStopId];
        const originStop = catalog.paradas[info.originStopId];
        if (!destStop) return;

        // Only useful while the user is riding towards a real destination. The
        // "waiting at the stop" case (origin == destination, arrival alarm) must
        // not fire the get-off alert.
        const isRiding = info.originStopId.toString() !== info.destinationStopId.toString();
        if (!isRiding) return;

        const prevStop = getPreviousStop(info.lineId, info.destinationStopId, catalog);

        getPosition().then((position) => {
            if (!position) {
                console.warn("[GPS Alert] Geolocation failed");
                return;
            }
            const userLat = position.lat;
            const userLon = position.lon;

            const distToDest = getDistance(userLat, userLon, destStop.posy, destStop.posx);

            let atPreviousStop = false;
            let passedPreviousStop = false;
            let distPrevToDest = Infinity;
            if (prevStop) {
                const distToPrev = getDistance(userLat, userLon, prevStop.posy, prevStop.posx);
                distPrevToDest = Math.max(80, getDistance(prevStop.posy, prevStop.posx, destStop.posy, destStop.posx));

                // Spacing-aware thresholds: when two stops are very close, the
                // alert must NOT fire too early or from the wrong stop. It only
                // fires at the second-to-last stop, or once the user is clearly
                // closer to the destination than to that stop.
                // Umbrales acordes a la distancia real entre paradas: con
                // paradas muy cercanas no debe avisar antes de tiempo ni desde
                // una parada equivocada.
                atPreviousStop = distToPrev < Math.min(100, distPrevToDest * 0.45);
                passedPreviousStop =
                    distToDest < distToPrev &&
                    distToDest < Math.max(70, distPrevToDest * 0.5);
            }
            // Fallback: if the route couldn't be resolved, still warn when the
            // user is physically close to the destination stop.
            const approachingDest = !prevStop && distToDest < 150;

            console.log(`[GPS Alert] distToDest: ${distToDest.toFixed(1)}m, atPrev: ${atPreviousStop}, passedPrev: ${passedPreviousStop}`);

            if (atPreviousStop || passedPreviousStop || approachingDest) {
                // Trigger warning!
                // Activar aviso
                localStorage.setItem('buscoruna_gps_alert_triggered', 'true');
                
                // Show modal overlay alert
                // Mostrar alerta emergente en pantalla
                const alertPopup = document.getElementById("gps-alert-popup");
                const alertDestName = document.getElementById("gps-alert-dest-name");
                if (alertDestName) alertDestName.textContent = destStop.nombre;
                if (alertPopup) alertPopup.style.display = "flex";

                // Vibrate device if supported
                // Vibrar el dispositivo si está soportado
                if (navigator.vibrate) {
                    navigator.vibrate([300, 100, 300, 100, 300]);
                }
                
                // Play the configured get-off/stop alert melody
                // Reproducir la melodía configurada para el aviso de parada
                playEventSound('stop');

                // Send background push/system notification if permission granted (compatible with Android/Chrome)
                // Enviar notificación del sistema si los permisos han sido concedidos (compatible con Android/Chrome)
                const gpsTitle = lang === 'en' ? '⚠️ PRESS THE STOP BUTTON!' : '⚠️ ¡PULSA EL BOTÓN DE PARADA!';
                const gpsBodyText = lang === 'en'
                    ? `You are approaching your destination: ${destStop.nombre}. Alert the driver!`
                    : `Te aproximas a tu destino: ${destStop.nombre}. ¡Avisa al conductor!`;
                sendNotification(gpsTitle, {
                    body: gpsBodyText,
                    requireInteraction: true,
                    icon: "/logo.png",
                    badge: "/logo.png"
                }).then((closeStopNotif) => {
                    // The stop-button notification also disappears 1 minute
                    // after being emitted, together with the auto-end of the
                    // journey (no user interaction needed).
                    // La notificación de "pulsa el botón" también desaparece
                    // 1 minuto después de emitirse, junto con el fin
                    // automático del viaje (sin interacción del usuario).
                    if (typeof closeStopNotif === "function") setTimeout(closeStopNotif, 60000);
                }).catch(() => {});
                // Only auto-end once on board: while still waiting at the
                // boarding stop ('toStop') this proximity alert can be a false
                // positive on short routes (boarding stop next to the
                // destination), and ending then would kill the journey before
                // the user even gets on the bus.
                // Solo acaba una vez a bordo: mientras se espera en la parada
                // ('toStop') este aviso por cercanía puede ser falso en rutas
                // cortas (parada de origen junto al destino) y acabaría el
                // viaje antes de subir.
                if ((info.phase || 'toStop') === 'toDest') scheduleJourneyAutoEnd();
            }
        });
    }

    // --- Wake Lock + Audio + Media Session (like YouTube) ---
    // Mantener la pantalla encendida y priorizar el proceso en Android
    let wakeLock: WakeLockSentinel | null = null;

    async function acquireWakeLock() {
        if ('wakeLock' in navigator) {
            try {
                wakeLock = await navigator.wakeLock.request('screen');
                wakeLock.addEventListener('release', () => {
                    console.log("[WakeLock] Released");
                });
                console.log("[WakeLock] Acquired");
            } catch (err) {
                console.warn("[WakeLock] Failed to acquire", err);
            }
        }
    }

    function releaseWakeLock() {
        if (wakeLock) {
            wakeLock.release();
            wakeLock = null;
            console.log("[WakeLock] Released manually");
        }
    }

    // Re-acquire wake lock if the page becomes visible again (user switches back)
    document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && wakeLock === null) {
            // If keep-awake is enabled and we lost the lock, re-acquire
            if (localStorage.getItem('buscoruna_bg_keep_awake') === 'true') {
                acquireWakeLock();
            }
        }
    });

    function startSilencePlayback() {
        if (audioContext) return;
        try {
            // 1) Screen Wake Lock — keep screen on
            acquireWakeLock();

            // 2) Media Session API — show "playing" in notification shade (like YouTube)
            if ('mediaSession' in navigator) {
                navigator.mediaSession.metadata = new MediaMetadata({
                    title: 'Coruña Bus',
                    artist: 'Seguimiento activo',
                    artwork: [{ src: '/logo.png', sizes: '512x512', type: 'image/png' }],
                });
                navigator.mediaSession.playbackState = 'playing';
            }

            // 3) Silent audio loop — helps Chrome keep the tab alive
            audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
            const buffer = audioContext.createBuffer(1, audioContext.sampleRate * 2, audioContext.sampleRate);
            const source = audioContext.createBufferSource();
            source.buffer = buffer;
            source.loop = true;
            
            silenceNode = audioContext.createGain();
            silenceNode.gain.setValueAtTime(0, audioContext.currentTime); // 0 volume
            
            source.connect(silenceNode);
            silenceNode.connect(audioContext.destination);
            source.start();
            console.log("[Background] Silence loop started successfully.");
            
            // Show persistent background tracking notification
            showBackgroundNotification();
        } catch (err) {
            console.warn("Failed to initiate silence background loop", err);
        }
    }

    function stopSilencePlayback() {
        // Release Wake Lock
        releaseWakeLock();

        // Reset Media Session
        if ('mediaSession' in navigator) {
            navigator.mediaSession.playbackState = 'none';
        }

        // Close audio context
        if (audioContext) {
            try {
                audioContext.close();
            } catch (e) {}
            audioContext = null;
            silenceNode = null;
        }
        closeBackgroundNotification();
    }

    function startGPSMonitor() {
        if (gpsInterval) clearInterval(gpsInterval);
        gpsInterval = setInterval(checkGPSAlert, 10000); // Check location every 10s
        checkGPSAlert();
    }

    function stopGPSMonitor() {
        if (gpsInterval) {
            clearInterval(gpsInterval);
            gpsInterval = null;
        }
    }

    // Apply alert configurations (starts/stops monitors and background loops)
