---
interface Props {
    title: string;
}

import CatalogLoader from "../components/CatalogLoader.astro";
import Icon from "../components/Icon.astro";
import InstallPopup from "../components/InstallPopup.astro";
import ProjectMenu from "../components/ProjectMenu.astro";
import ProjectDrawer from "../components/ProjectDrawer.astro";
import { getTranslations } from "../utils/i18n";
import pkg from "../../package.json";

const acceptLanguage = Astro.request.headers.get('accept-language') || '';
const defaultLang = acceptLanguage.toLowerCase().includes('en') ? 'en' : 'es';
const cookieLang = Astro.cookies.get('buscoruna_lang')?.value;
const lang = cookieLang || defaultLang;
const t = getTranslations(lang);
const showLangSelector = !cookieLang;

const { title } = Astro.props;
---

<!doctype html>
<html lang={lang} data-lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <!-- App version (web changelog). Expuesta para que "Novedades" funcione
             también en la web, no solo en el APK nativo. -->
        <meta name="app-version" content={pkg.version} />
        <meta
            name="description"
            content={t.metaDescription || "Coruña Bus - El mejor planificador de rutas y tiempos en tiempo real para los buses de A Coruña. Consulta paradas, líneas y horarios actualizados."}
        />
        <meta
            name="keywords"
            content={t.metaKeywords || "bus coruña, tranvias coruña, tiempos bus coruña, paradas bus coruña, transporte publico a coruña"}
        />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <link rel="apple-touch-icon" href="/logo.png" />
        <link rel="manifest" href="/manifest.webmanifest" />
        <meta name="theme-color" content="#f44336" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta
            name="apple-mobile-web-app-status-bar-style"
            content="black-translucent"
        />
        <meta name="apple-mobile-web-app-title" content="Coruña Bus" />
        <meta name="generator" content={Astro.generator} />

        <script>
            // Register Service Worker for PWA only on the web (not in native Capacitor app)
            if ("serviceWorker" in navigator) {
                const isNative = typeof (window as any).Capacitor !== 'undefined' && (window as any).Capacitor?.isNativePlatform?.();
                if (isNative) {
                    navigator.serviceWorker.getRegistrations().then((registrations) => {
                        for (const registration of registrations) {
                            registration.unregister();
                        }
                    });
                } else {
                    window.addEventListener("load", () => {
                        navigator.serviceWorker.register("/sw.js");
                    });
                }
            }
        </script>

        <!-- SEO & Social Media -->
        <meta
            property="og:title"
            content={title || "Coruña Bus"}
        />
        <meta
            property="og:description"
            content={t.ogDescription || "Planifica tu ruta y consulta tiempos de llegada de los buses de A Coruña en tiempo real."}
        />
        <meta property="og:image" content="/logo.png" />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Coruña Bus" />
        <meta
            name="twitter:description"
            content={t.twitterDescription || "Tiempos y rutas de bus en A Coruña al instante."}
        />
        <meta name="twitter:image" content="/logo.png" />

        <link
            rel="stylesheet"
            href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
            integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
            crossorigin=""
        />
        <script
            src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
        <title>{title.replace("BusCoruña", "Coruña Bus")}</title>
    </head>
    <body>
        <CatalogLoader />
        <InstallPopup />

        <!-- Global Loader Popup (non-blocking, sits above the header) -->
        <div id="global-api-loader" class="global-loader-popup" role="status" aria-live="polite">
            <span class="loader-spinner" aria-hidden="true"></span>
            <span class="loader-text">{t.loadingData}</span>
        </div>

        <header class="main-header">
            <div class="header-content">
                <a
                    href="/"
                    class="logo-container"
                    style="text-decoration: none; color: inherit;"
                >
                    <img
                        src="/favicon.svg"
                        alt="Coruña Bus Logo"
                        class="header-logo"
                        id="header-logo"
                    />
                    <h1>Coruña<span>Bus</span></h1>
                </a>
                <div class="header-actions">
                    <div id="last-update" class="last-update">...</div>
                    <button
                        id="global-refresh-btn"
                        class="refresh-btn"
                        title={t.updateData}
                    >
                        <Icon name="refresh" size={18} />
                    </button>
                    <button
                        id="open-settings-btn"
                        class="refresh-btn"
                        title={t.alertSettings}
                    >
                        <Icon name="settings" size={18} />
                    </button>
                    <ProjectMenu />
                </div>
            </div>
        </header>
        <main>
            <slot />

            <footer class="global-recommendation">
                <div id="android-apk-footer-card" class="card recommendation-card android-download-card" style="display: none;">
                    <Icon name="download" size={24} class="text-primary" />
                    <p><strong>{t.downloadAndroidTitle}</strong></p>
                    <p style="font-size: 0.85rem; color: #666; margin-top: -0.25rem;">{t.downloadAndroidDesc}</p>
                    <div class="play-store-notice" style="width: 100%; margin: 0.25rem 0 0.9rem; background: #f0fdf4; border: 1.5px solid #bbf7d0; padding: 0.6rem 0.8rem; border-radius: 10px; text-align: center;">
                        <strong style="font-size: 0.83rem; color: #166534;">{t.playStoreComingSoon}</strong>
                        <p style="margin: 0.2rem 0 0; font-size: 0.75rem; color: #166534; opacity: 0.9; line-height: 1.35;">{t.playStoreComingSoonDesc}</p>
                    </div>
                    <div class="recommendation-actions" style="width: 100%; justify-content: center;">
                        <a
                            href="https://github.com/jaimegh-es/buscoruna/releases/latest/download/app-debug.apk"
                            id="footer-download-apk-btn"
                            class="btn-primary apk-download-link"
                            download="coruna-bus.apk"
                            style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; max-width: 280px; padding: 0.65rem 1rem; border-radius: 8px; font-weight: 700;"
                        >
                            <Icon name="download" size={18} />
                            <span>{t.downloadAndroidBtn}</span>
                        </a>
                    </div>
                </div>

                <div class="card recommendation-card">
                    <Icon name="heart" size={20} class="text-primary" />
                    <p>{t.recomendarApp}</p>
                    <div class="recommendation-actions">
                        <button id="share-app-btn" class="btn-share-subtle"
                            >{t.compartirApp}</button
                        >
                        <a
                            href="https://github.com/jaimegh-es/buscoruna"
                            target="_blank"
                            class="btn-github-subtle"
                        >
                            {t.sugerencias}
                        </a>
                    </div>
                    <p class="contact-info">
                        {t.contacto} <a
                            href="mailto:contacto@inled.es"
                            >contacto@inled.es</a>
                    </p>
                </div>

                <div class="legal-disclaimer">
                    <p>
                        <strong>{t.disclaimerTitle}</strong> {t.disclaimerContent}
                    </p>
                    <p style="margin-top:0.5rem;">
                        <a href="/welcome" style="color: var(--primary); font-weight: 700; text-decoration: none;">{t.footerWelcomeLink}</a>
                    </p>
                </div>
            </footer>
        </main>

        <!-- Tracking Bar -->
        <div id="tracking-bar" class="tracking-bar" style="display: none;">
            <div class="tracking-content">
                <div class="tracking-main">
                    <span class="tracking-bus-badge" id="track-bus-id">...</span>
                    <div class="tracking-text">
                        <strong>{t.trackingBarDest} <span id="track-dest-name">...</span></strong>
                        <small id="track-status">{t.trackingBarCalc}</small>
                    </div>
                    <button
                        id="edit-tracking-dest"
                        class="edit-track-btn"
                        title={t.trackingBarEdit}
                    >
                        <Icon name="edit" size={14} />
                    </button>
                </div>
                <div class="tracking-eta" id="track-eta-val">--</div>
                <button id="stop-tracking" class="stop-track-btn" title={t.trackingBarStop}>
                    <Icon name="x" size={20} />
                </button>
            </div>
            <div id="web-tracking-hint" class="web-tracking-hint" style="display: none;">
                <span>{t.webTrackingHint} <a id="track-bar-apk-link" href="#" target="_blank">{t.webTrackingHintLink}</a></span>
            </div>
        </div>

        <!-- GPS Notification Overlay Popup -->
        <!-- Ventana Emergente de Aviso de Parada -->
        <div id="gps-alert-popup" class="gps-alert-popup" style="display: none;">
            <div class="gps-alert-card">
                <div class="gps-alert-header">
                    <Icon name="bus" size={24} />
                    <h3>{t.gpsAlertTitle}</h3>
                </div>
                <div class="gps-alert-body">
                    <p>{t.gpsAlertArriving} <strong id="gps-alert-dest-name">...</strong></p>
                    <p class="gps-alert-cta">{t.gpsAlertCta}</p>
                </div>
                <button type="button" id="btn-close-gps-alert" class="btn-primary">{t.gpsAlertUnderstand}</button>
            </div>
        </div>

        <!-- Settings Modal overlay (Ajustes de Alertas) -->
        <div id="settings-modal" class="modal-overlay" style="display: none;">
            <div class="modal-content settings-modal-content">
                <div class="modal-header">
                    <h3>{t.settingsTitle}</h3>
                    <button type="button" id="close-settings" class="close-btn">
                        <Icon name="x" size={24} />
                    </button>
                </div>
                <div class="modal-body settings-modal-body">
                    <!-- Setting 1: GPS Destination Stop Prompt -->
                    <div class="setting-item">
                        <div class="setting-info">
                            <label class="setting-title" for="settings-enable-gps-alert">
                                <span>{t.settingsGpsTitle}</span>
                                <input type="checkbox" id="settings-enable-gps-alert" />
                            </label>
                            <p class="setting-desc">{t.settingsGpsDesc}</p>
                            <p class="setting-warn">{t.settingsGpsWarn}</p>
                        </div>
                    </div>

                    <!-- Setting 2: Boarding Bus Stop ETA Prompt -->
                    <div class="setting-item">
                        <div class="setting-info">
                            <label class="setting-title" for="settings-enable-eta-alert">
                                <span>{t.settingsEtaTitle}</span>
                                <input type="checkbox" id="settings-enable-eta-alert" />
                            </label>
                            <p class="setting-desc">{t.settingsEtaDesc}</p>
                            <p class="setting-warn" id="settings-eta-warn-web">{t.settingsEtaWarn}</p>
                            <p class="setting-desc" id="settings-eta-warn-native" style="display:none">{t.settingsEtaNativeDesc}</p>
                            
                            <div class="setting-sub-option" id="eta-alert-threshold-group">
                                <label for="settings-eta-threshold">{t.settingsEtaMinutes}</label>
                                <select id="settings-eta-threshold">
                                    <option value="0">{t.settingsEtaMinutes0}</option>
                                    <option value="1">{t.settingsEtaMinutes1}</option>
                                    <option value="2">{t.settingsEtaMinutes2}</option>
                                    <option value="3">{t.settingsEtaMinutes3}</option>
                                    <option value="5">{t.settingsEtaMinutes5}</option>
                                    <option value="10">{t.settingsEtaMinutes10}</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Setting 3: Persistent Background Notification -->
                    <div class="setting-item">
                        <div class="setting-info">
                            <label class="setting-title" for="settings-enable-bg-keep-awake">
                                <span>{t.settingsBgTitle}</span>
                                <input type="checkbox" id="settings-enable-bg-keep-awake" />
                            </label>
                            <p class="setting-desc">{t.settingsBgDesc}</p>
                        </div>
                    </div>

                    <!-- Setting 3.4: Alert melodies (bus arrival + get-off) -->
                    <div class="setting-item">
                        <div class="setting-info">
                            <label class="setting-title">
                                <span>{t.settingsSoundsTitle}</span>
                            </label>
                            <p class="setting-desc">{t.settingsSoundsDesc}</p>

                            <div style="display: flex; flex-direction: column; gap: 0.7rem; margin-top: 0.85rem;">
                                <!-- Bus arrival sound -->
                                <div class="sound-row">
                                    <div class="sound-row-main">
                                        <strong style="font-size:0.9rem;">{t.settingsSoundBusLabel}</strong>
                                        <span id="sound-badge-bus" class="sound-badge"></span>
                                    </div>
                                    <div class="sound-row-actions">
                                        <button type="button" id="sound-test-bus" class="btn-secondary sound-btn" title={t.settingsSoundTestTitle}><Icon name="play" size={14} /><span>{t.settingsSoundTest}</span></button>
                                        <button type="button" id="sound-upload-bus" class="btn-secondary sound-btn" title={t.settingsSoundUploadTitle}><Icon name="upload" size={14} /><span>{t.settingsSoundUpload}</span></button>
                                        <button type="button" id="sound-remove-bus" class="btn-secondary sound-btn sound-btn-remove" style="display:none" title={t.settingsSoundRemoveTitle}><Icon name="trash" size={14} /><span>{t.settingsSoundRemove}</span></button>
                                    </div>
                                    <input type="file" id="sound-file-bus" accept="audio/mpeg,audio/mp3,audio/*" style="display:none;" />
                                </div>

                                <!-- Get-off / stop alert sound -->
                                <div class="sound-row">
                                    <div class="sound-row-main">
                                        <strong style="font-size:0.9rem;">{t.settingsSoundStopLabel}</strong>
                                        <span id="sound-badge-stop" class="sound-badge"></span>
                                    </div>
                                    <div class="sound-row-actions">
                                        <button type="button" id="sound-test-stop" class="btn-secondary sound-btn" title={t.settingsSoundTestTitle}><Icon name="play" size={14} /><span>{t.settingsSoundTest}</span></button>
                                        <button type="button" id="sound-upload-stop" class="btn-secondary sound-btn" title={t.settingsSoundUploadTitle}><Icon name="upload" size={14} /><span>{t.settingsSoundUpload}</span></button>
                                        <button type="button" id="sound-remove-stop" class="btn-secondary sound-btn sound-btn-remove" style="display:none" title={t.settingsSoundRemoveTitle}><Icon name="trash" size={14} /><span>{t.settingsSoundRemove}</span></button>
                                    </div>
                                    <input type="file" id="sound-file-stop" accept="audio/mpeg,audio/mp3,audio/*" style="display:none;" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Setting 3.5: User Locations & Walking Times -->
                    <div class="setting-item">
                        <div class="setting-info">
                            <label class="setting-title">
                                <span>{t.settingsLocationsTitle}</span>
                            </label>
                            <p class="setting-desc">{t.settingsLocationsDesc}</p>
                            
                            <div style="margin-top: 0.75rem;">
                                <label for="settings-active-location" style="font-size: 0.85rem; font-weight: 700; color: var(--text); display: block; margin-bottom: 0.35rem;">{t.settingsActiveLocation}</label>
                                <div style="display: flex; gap: 0.5rem; align-items: center;">
                                    <select id="settings-active-location" style="flex: 1; padding: 0.65rem; border-radius: 10px; border: 1.5px solid #e2e8f0; background: var(--card-bg); color: var(--text); font-size: 0.95rem; font-weight: 600;">
                                    </select>
                                    <button type="button" id="settings-btn-add-location" class="btn-secondary" style="width: auto; padding: 0.65rem 0.95rem; font-size: 0.85rem; font-weight: 700; white-space: nowrap; border-radius: 10px; display: inline-flex; align-items: center; gap: 0.4rem;">
                                        <Icon name="plus" size={16} />
                                        <span>{t.settingsAddLocationBtn}</span>
                                    </button>
                                </div>
                            </div>

                            <div id="settings-add-location-row" style="display: none; margin-top: 0.6rem;">
                                <div style="display: flex; gap: 0.5rem; align-items: center;">
                                    <input type="text" id="settings-new-location-name" maxlength="40" placeholder={t.settingsLocationPrompt} style="flex: 1; padding: 0.6rem 0.7rem; border-radius: 10px; border: 1.5px solid #e2e8f0; background: var(--card-bg); color: var(--text); font-size: 0.9rem;" />
                                    <button type="button" id="settings-confirm-add-location" class="btn-primary" style="padding: 0.6rem 1rem; font-size: 0.85rem; font-weight: 700; white-space: nowrap; border-radius: 10px; display: inline-flex; align-items: center; gap: 0.4rem;">
                                        <Icon name="plus" size={16} />
                                        <span>{t.settingsLocationAdd}</span>
                                    </button>
                                    <button type="button" id="settings-cancel-add-location" class="btn-secondary" title={t.settingsLocationCancelTitle} style="padding: 0.6rem 0.7rem; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center;">
                                        <Icon name="x" size={16} />
                                    </button>
                                </div>
                            </div>

                            <div id="settings-locations-list" style="margin-top: 0.85rem; display: flex; flex-direction: column; gap: 0.5rem;">
                            </div>
                        </div>
                    </div>

                    <!-- Setting 3.6: Data Migration & Backup (PWA to APK / Backup) -->
                    <div class="setting-item">
                        <div class="setting-info">
                            <label class="setting-title">
                                <span>{t.migrationTitle}</span>
                            </label>
                            <p class="setting-desc">{t.migrationDesc}</p>
                            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem;">
                                <button type="button" id="btn-forzar-recarga" class="btn-secondary" style="flex: 1; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.6rem 0.9rem; font-size: 0.88rem; font-weight: 700; border-radius: 10px; white-space: nowrap; background:#fef3f2; border-color:#fecaca; color:#dc2626;">
                                    <Icon name="refresh" size={16} />
                                    <span>Forzar recarga de vistas</span>
                                </button>
                                <button type="button" id="btn-export-data" class="btn-secondary" style="flex: 1; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.6rem 0.9rem; font-size: 0.88rem; font-weight: 700; border-radius: 10px; white-space: nowrap;">
                                    <Icon name="share" size={16} />
                                    <span>{t.migrationExportBtn}</span>
                                </button>
                                <button type="button" id="btn-import-data" class="btn-secondary" style="flex: 1; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.6rem 0.9rem; font-size: 0.88rem; font-weight: 700; border-radius: 10px; white-space: nowrap;">
                                    <Icon name="download" size={16} />
                                    <span>{t.migrationImportBtn}</span>
                                </button>
                                <input type="file" id="input-import-file" accept=".json,application/json" style="display:none;" />
                            </div>
                        </div>
                    </div>

                    <!-- Web Background Alert Notice Card (Shown only on web) -->
                    <div id="settings-web-bg-notice" class="web-bg-notice-card" style="display: none;">
                        <div class="web-notice-icon">📱</div>
                        <div class="web-notice-content">
                            <strong>{t.webTrackingNoticeTitle}</strong>
                            <p>{t.webTrackingNotice}</p>
                            <a id="settings-web-notice-apk-btn" href="#" class="btn-notice-apk">
                                {t.downloadAndroidBtn}
                            </a>
                        </div>
                    </div>

                    <!-- Setting 4: App Update (native only) -->
                    <!-- Ajuste 4: Actualización de la app (solo nativo) -->
                    <div class="setting-item" id="settings-update-item" style="display:none">
                        <div class="setting-info">
                            <label class="setting-title">
                                <span>{t.settingsUpdateTitle}</span>
                            </label>
                            <p class="setting-desc">{t.settingsUpdateDesc}</p>
                            <div id="settings-update-status" class="update-status" style="display:none"></div>
                            <div class="update-progress-wrap" id="update-progress-wrap" style="display:none">
                                <div class="update-progress-bar"><div id="update-progress-fill"></div></div>
                                <small id="update-progress-text">0%</small>
                            </div>
                            <button type="button" id="btn-check-update" class="btn-secondary update-btn">{t.settingsUpdateCheck}</button>

                            <!-- Obtainium Updater Option -->
                            <div class="obtainium-box" style="margin-top: 1.15rem; padding-top: 0.95rem; border-top: 1px dashed #e2e8f0;">
                                <label class="setting-title" style="font-size: 0.9rem; font-weight: 700; margin-bottom: 0.35rem; display: flex; align-items: center; gap: 0.4rem;">
                                    <span>{t.obtainiumTitle}</span>
                                </label>
                                <p class="setting-desc" style="margin-bottom: 0.75rem;">{t.obtainiumDesc}</p>
                                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    <a href="obtainium://add/https://github.com/jaimegh-es/buscoruna" class="btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 0.9rem; font-size: 0.85rem; font-weight: 700; border-radius: 10px;">
                                        <Icon name="download" size={16} />
                                        <span>{t.obtainiumAddBtn}</span>
                                    </a>
                                    <a href="https://github.com/ImranR98/Obtainium/releases/latest" target="_blank" rel="noopener noreferrer" class="btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 0.9rem; font-size: 0.85rem; font-weight: 600; border-radius: 10px;">
                                        <span>{t.obtainiumDownloadBtn}</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Android App Download Item (shown when on web/PWA) -->
                    <!-- Descarga de App Android (mostrado en web/PWA) -->
                    <div class="setting-item" id="settings-android-download-item">
                        <div class="setting-info">
                            <label class="setting-title">
                                <span>{t.downloadAndroidTitle}</span>
                            </label>
                            <p class="setting-desc">{t.downloadAndroidDesc}</p>

                            <a href="https://github.com/jaimegh-es/buscoruna/releases/latest/download/app-debug.apk" id="settings-download-apk-btn" class="btn-primary update-btn" download="coruna-bus.apk" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center; gap:0.5rem; width:100%; min-height:48px; border-radius:12px; font-weight:700;">
                                <Icon name="download" size={18} />
                                <span>{t.downloadAndroidBtn}</span>
                            </a>
                            
                            <!-- Obtainium Option in Web Settings -->
                            <div class="obtainium-box" style="margin-top: 1rem; padding-top: 0.85rem; border-top: 1px dashed #e2e8f0;">
                                <label class="setting-title" style="font-size: 0.88rem; font-weight: 700; margin-bottom: 0.35rem; display: block;">
                                    <span>{t.obtainiumTitle}</span>
                                </label>
                                <p class="setting-desc" style="margin-bottom: 0.65rem;">{t.obtainiumDesc}</p>
                                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    <a href="obtainium://add/https://github.com/jaimegh-es/buscoruna" class="btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 0.9rem; font-size: 0.85rem; font-weight: 700; border-radius: 10px;">
                                        <Icon name="download" size={16} />
                                        <span>{t.obtainiumAddBtn}</span>
                                    </a>
