---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getTranslations } from '../utils/i18n';

const lang = Astro.cookies.get('buscoruna_lang')?.value || 'es';
const t = getTranslations(lang);
---

<Layout title={`${t.favsTitle} - Coruña Bus`}>
	<section class="favorites-page">
    <h2>{t.favsPageTitle}</h2>
    <div id="favorites-container">
      <div class="loading-state">
        <div class="loading">{t.favsLoadingFavs}</div>
        <div class="skeleton-stack" aria-hidden="true">
          <div class="skeleton skeleton-card" style="height:58px"></div>
          <div class="skeleton skeleton-card" style="height:58px"></div>
          <div class="skeleton skeleton-card" style="height:58px"></div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { storage } from '../utils/storage';
    import { API } from '../services/api';
    import { tracking } from '../utils/tracking';
    import { guardPhantomClicks } from '../utils/phantomClicks';
    import { createIcons, Star, Heart, ChevronRight, Map, Pencil } from 'lucide';
    import { getTranslations } from '../utils/i18n';

    const lang = document.documentElement.getAttribute('data-lang') || 'es';
    const t = getTranslations(lang);

    // The cards are NOT <a href> on purpose. On real WebViews a scroll gesture
    // that starts on an anchor ends, once the fling settles, in the engine
    // natively activating that anchor — with no DOM click at all, so no
    // listener can block it (the favourites auto-open after scrolling). A plain
    // element cannot be activated natively; navigation happens only through the
    // trusted click below, which guardPhantomClicks validates.
    // Las tarjetas NO son <a href> a propósito: en WebViews reales, un gesto de
    // scroll que empieza en un enlace termina, al asentarse el fling, activando
    // nativamente ese enlace — sin ningún click DOM, así que ningún listener
    // puede bloquearlo. Un elemento plano no se puede activar nativamente; la
    // navegación solo ocurre por el click de confianza de abajo, validado por
    // guardPhantomClicks.
    let lastRenderedHtml: string | null = null;

    function paint(container: HTMLElement, html: string): boolean {
      if (html === lastRenderedHtml) return false;
      lastRenderedHtml = html;
      container.innerHTML = html;
      return true;
    }

    // Load and render all favorites categories (stops, routes, planner trajectories)
    // Cargar y renderizar todas las categorías de favoritos (paradas, rutas, trayectos del planificador)
    async function loadFavorites() {
      const container = document.getElementById('favorites-container');
      if (!container) return;

      const favIds = storage.getFavorites();
      const favRoutes = storage.getFavoriteRoutes();
      const favPlannerRoutes = storage.getFavoritePlannerRoutes();
      const catalog = storage.getCatalog();

      // Check if there are no favorites at all
      // Comprobar si no hay ningún favorito guardado
      if (favIds.length === 0 && favRoutes.length === 0 && favPlannerRoutes.length === 0) {
        paint(container, `
          <div class="empty-state">
            <span class="icon"><i data-lucide="star"></i></span>
            <p>${t.favsNoFavsYet}</p>
            <p><small>${t.favsHint}</small></p>
          </div>
        `);
        createIcons({ icons: { Star, Pencil } });
        return;
      }

      if (!catalog) {
        paint(container, `<p>${t.favsDataError}</p>`);
        return;
      }

      const lines = catalog.actualizacion.lineas || [];
      const lineMap = lines.reduce((acc: any, line: any) => {
        acc[line.id] = { name: line.lin_comer, color: line.color };
        return acc;
      }, {});

      let html = '';

      // Render favorite stops
      // Renderizar paradas favoritas
      if (favIds.length > 0) {
        const stopNames = storage.getStopNames();
        html += `
          <h3 class="section-title">${t.favsStops}</h3>
          <div class="stops-list anim-stagger">
            ${favIds.map(id => {
              const s = catalog.paradas[id];
              if (!s) return '';
              const displayName = stopNames[String(id)] || s.nombre;
              const hasAlias = !!stopNames[String(id)];
              return `
                <div class="card stop-card-link" role="link" tabindex="0" data-href="/stop/${s.id}">
                  <div class="stop-info">
                    <strong>${displayName}</strong>
                    <small>${hasAlias ? `${s.nombre} · ` : ''}${lang === 'en' ? 'Stop' : 'Parada'} ${s.id}</small>
                    <div class="stop-lines">
                      ${s.enlaces.map((lId: any) => {
                        const info = lineMap[lId];
                        if (!info) return '';
                        return `<span class="line-tag" style="background-color: #${info.color}">${info.name}</span>`;
                      }).join('')}
                    </div>
                  </div>
                  <div class="stop-actions">
                    <button type="button" class="rename-stop-btn icon-btn" data-stop-id="${s.id}" data-stop-name="${s.nombre}" title="${lang === 'en' ? 'Rename stop' : 'Renombrar parada'}" aria-label="${lang === 'en' ? 'Rename stop' : 'Renombrar parada'}"><i data-lucide="pencil"></i></button>
                    <div class="stop-arrow"><i data-lucide="chevron-right"></i></div>
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        `;
      }

      // Render favorite line routes (specific line connecting origin & dest stops)
      // Renderizar rutas favoritas de líneas (línea específica que conecta origen y destino)
      if (favRoutes.length > 0) {
        html += `
          <h3 class="section-title mt-2">${t.favsRoutes}</h3>
          <div class="routes-list anim-stagger">
            ${favRoutes.map(r => {
              const origin = catalog.paradas[r.originId];
              const dest = catalog.paradas[r.destId];
              const line = lines.find((l: any) => l.id === r.lineId);
              const color = line ? `#${line.color}` : 'var(--primary)';

              // The stop view uses these params to highlight today's bus to
              // board that fulfils the favorite (dest + optional target time).
              // La vista de parada usa estos parámetros para resaltar hoy el
              // bus a coger que cumple el favorito (destino + hora opcional).
              const rParams = new URLSearchParams();
              rParams.set('dest', String(r.destId));
              rParams.set('line', String(r.lineId));
              if (r.plannerMode) rParams.set('mode', r.plannerMode);
              if (r.targetTime) rParams.set('time', r.targetTime);
              const rHref = `/stop/${r.originId}?${rParams.toString()}`;
              
              return `
                <div class="card route-fav-card favorite-route-link" role="link" tabindex="0" style="--line-color: ${color}" data-href="${rHref}" data-dest="${r.destId}">
                  <div class="route-fav-header">
                    <span class="line-badge-small" style="background-color: ${color}">${r.lineName}</span>
                    <div class="route-fav-text">
                      <strong>${origin?.nombre || (lang === 'en' ? 'Origin' : 'Origen')} &rarr; ${dest?.nombre || (lang === 'en' ? 'Destination' : 'Destino')}</strong>
                      <small>${lang === 'en' ? 'From stop' : 'Desde parada'} ${r.originId}${r.plannerMode === 'arrive' && r.targetTime ? ` • 🕒 ${lang === 'en' ? 'Arrive at' : 'Llegar a las'} ${r.targetTime}` : ''}</small>
                    </div>
                  </div>
                  <div class="stop-arrow"><i data-lucide="chevron-right"></i></div>
                </div>
              `;
            }).join('')}
          </div>
        `;
      }

      // Render favorite planner trajectories (Origin -> Destination search queries)
      // Renderizar trayectos favoritos del planificador (consultas de búsqueda Origen -> Destino)
      if (favPlannerRoutes.length > 0) {
        html += `
          <h3 class="section-title mt-2">${t.favsPlanner}</h3>
          <div class="routes-list anim-stagger">
            ${favPlannerRoutes.map(r => {
              const originName = r.origin.nombre;
              const destName = r.destination.nombre;

              // Build URLSearchParams from saved origin/destination stop or custom place
              // Construir URLSearchParams desde el origen/destino guardado (parada o lugar personalizado)
              const params = new URLSearchParams();
              params.set('originType', r.origin.type);
              if (r.origin.type === 'stop') {
                params.set('originId', r.origin.id);
              } else {
                params.set('originName', r.origin.nombre);
                params.set('originLat', r.origin.posy);
                params.set('originLon', r.origin.posx);
              }
              
              params.set('destType', r.destination.type);
              if (r.destination.type === 'stop') {
                params.set('destId', r.destination.id);
              } else {
                params.set('destName', r.destination.nombre);
                params.set('destLat', r.destination.posy);
                params.set('destLon', r.destination.posx);
              }

              if (r.plannerMode) {
                params.set('plannerMode', r.plannerMode);
              }
              if (r.targetTime) {
                params.set('targetTime', r.targetTime);
              }

              const href = `/planner?${params.toString()}`;

              return `
                <div class="card route-fav-card favorite-planner-link" role="link" tabindex="0" style="--line-color: var(--primary)" data-href="${href}">
                  <div class="route-fav-header">
                    <span class="line-badge-small flex-center" style="background-color: var(--primary); display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; padding: 0;">
                      <i data-lucide="map" style="width: 16px; height: 16px; color: white;"></i>
                    </span>
                    <div class="route-fav-text">
                      <strong>${originName} &rarr; ${destName}</strong>
                      <small>
                        ${r.origin.type === 'stop' ? (lang === 'en' ? 'Stop ' : 'Parada ') + r.origin.id : (lang === 'en' ? 'My location' : 'Mi ubicación')} &rarr; ${r.destination.type === 'stop' ? (lang === 'en' ? 'Stop ' : 'Parada ') + r.destination.id : (lang === 'en' ? 'Location' : 'Ubicación')}
                        ${r.plannerMode === 'arrive' && r.targetTime ? ` • 🕒 ${lang === 'en' ? 'Arrive at' : 'Llegar a las'} ${r.targetTime}` : ''}
                      </small>
                    </div>
                  </div>
                  <div class="stop-arrow"><i data-lucide="chevron-right"></i></div>
                </div>
              `;
            }).join('')}
          </div>
        `;
      }

      if (!paint(container, html)) return;
      createIcons({ icons: { Star, Heart, ChevronRight, Map, Pencil } });

      // Navigation for the cards now that they are not anchors: a trusted
      // click only (real tap, keyboard via the keydown path). Clicks flattened
      // onto an inner button are the rename pencil, handled below; untrusted
      // clicks (code-built events) never navigate.
      // Navegación de las tarjetas ahora que no son enlaces: solo click de
      // confianza (toque real, o teclado por el keydown). El botón del lápiz
      // se gestiona abajo; los clicks no confiables nunca navegan.
      container.querySelectorAll<HTMLElement>('.stop-card-link, .route-fav-card').forEach((card) => {
        const href = card.getAttribute('data-href');
        if (!href) return;
        card.addEventListener('click', (e) => {
          if (!e.isTrusted) return;
          if (e.target instanceof Element && e.target.closest('button')) return;
          window.location.href = href;
        });
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            window.location.href = href;
          }
        });
      });

      // Add listeners to favorite route links to set target destination
      // Añadir oyentes a los enlaces de rutas favoritas para establecer la parada destino
      container.querySelectorAll('.favorite-route-link').forEach(link => {
        link.addEventListener('click', (e) => {
          const destId = link.getAttribute('data-dest');
          if (destId) {
            tracking.setTargetDestination(parseInt(destId));
          }
        });
      });

      // Rename stop buttons (custom nicknames)
      // Botones de renombrar parada (nombres personalizados)
      const renameLabels = lang === 'en'
        ? { title: 'Rename stop', placeholder: 'Custom name (e.g. Home)', save: 'Save', remove: 'Remove name' }
        : { title: 'Renombrar parada', placeholder: 'Nombre personalizado (ej. Casa)', save: 'Guardar', remove: 'Quitar nombre' };

      container.querySelectorAll('.rename-stop-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const stopId = parseInt(btn.getAttribute('data-stop-id')!);
          const officialName = btn.getAttribute('data-stop-name') || '';
          const current = storage.getStopNames()[String(stopId)] || '';

          // Lightweight prompt UI built on top of the existing modal styles
          // Interfaz ligera de edición reutilizando los estilos del modal
          let modal = document.getElementById('rename-stop-modal') as HTMLDivElement | null;
          if (!modal) {
            modal = document.createElement('div');
            modal.id = 'rename-stop-modal';
            modal.className = 'modal-overlay';
            modal.innerHTML = `
              <div class="modal-content settings-modal-content rename-modal-content">
                <h3 id="rename-stop-title" style="margin:0"></h3>
                <input type="text" id="rename-stop-input" class="rename-input" maxlength="60" />
                <small id="rename-stop-official" class="muted"></small>
                <div class="rename-actions">
                  <button type="button" id="rename-stop-remove" class="btn-secondary"></button>
                  <button type="button" id="rename-stop-save" class="btn-primary"></button>
                </div>
                <button type="button" id="rename-stop-cancel" class="link-btn"></button>
              </div>
            `;
            document.body.appendChild(modal);
          }

          const input = document.getElementById('rename-stop-input') as HTMLInputElement;
          const officialEl = document.getElementById('rename-stop-official')!;
          const titleEl = document.getElementById('rename-stop-title')!;
          const saveBtn = document.getElementById('rename-stop-save')!;
          const removeBtn = document.getElementById('rename-stop-remove')!;
          const cancelBtn = document.getElementById('rename-stop-cancel')!;

          titleEl.textContent = renameLabels.title;
          officialEl.textContent = officialName;
          saveBtn.textContent = renameLabels.save;
          removeBtn.textContent = renameLabels.remove;
          cancelBtn.textContent = t.cancel;
          input.value = current;
          input.placeholder = renameLabels.placeholder;
          modal.style.display = 'flex';
          input.focus();

          const close = () => { modal!.style.display = 'none'; };
          saveBtn.onclick = () => {
            storage.setStopName(stopId, input.value);
            close();
            loadFavorites();
          };
          input.onkeydown = (ev) => {
            if (ev.key === 'Enter') saveBtn.onclick?.(new Event('click') as any);
            if (ev.key === 'Escape') close();
          };
          removeBtn.onclick = () => {
            storage.removeStopName(stopId);
            close();
            loadFavorites();
          };
          cancelBtn.onclick = close;
          modal.onclick = (ev) => { if (ev.target === modal) close(); };
        });
      });
    }

    // Installed on the container, not on the cards, so it survives every repaint
    // and does not have to be re-attached.
    // Se instala en el contenedor, no en las tarjetas, para sobrevivir a los
    // repintados sin volver a conectarlo.
    const favoritesContainer = document.getElementById('favorites-container');
    if (favoritesContainer) guardPhantomClicks(favoritesContainer);

    loadFavorites();

    window.addEventListener('catalog-loaded', () => {
      loadFavorites();
    });
  </script>
</Layout>

<style is:global>
  .stop-card-link, .route-fav-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    margin-bottom: 1rem;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .route-fav-card {
    position: relative;
    border-left: none !important;
    overflow: hidden;
  }

  .route-fav-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background-color: var(--line-color, var(--primary));
  }

  .stop-lines {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 0.5rem;
  }

  .line-tag {
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    color: white;
  }

  .section-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .mt-2 { margin-top: 2rem; }

  .route-fav-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-grow: 1;
    min-width: 0;
  }

  .line-badge-small {
    color: white;
    font-weight: 800;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.85rem;
    min-width: 35px;
    text-align: center;
  }

  .route-fav-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .route-fav-text strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .route-fav-text small {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }

  .stop-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .icon-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--text-muted);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-btn:hover {
    color: var(--primary);
    background: rgba(244, 67, 54, 0.08);
  }

  .icon-btn svg {
    width: 22px;
    height: 22px;
    stroke-width: 2.4;
  }

  .rename-modal-content {
    max-width: 360px;
    width: 90%;
  }

  .rename-input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--border, #ddd);
    border-radius: 8px;
    font-size: 1rem;
    margin: 0.75rem 0 0.25rem;
    box-sizing: border-box;
  }

  .muted { color: var(--text-muted); font-size: 0.8rem; }

  .rename-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .rename-actions button {
    flex: 1;
    padding: 0.65rem;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-weight: 600;
  }

  .rename-actions .btn-primary {
    background: var(--primary);
    color: white;
  }

  .rename-actions .btn-secondary {
    background: transparent;
    border: 1px solid var(--border, #ddd);
    color: var(--text);
  }

  .link-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    margin-top: 0.75rem;
    cursor: pointer;
    text-decoration: underline;
    font-size: 0.85rem;
  }

  .empty-state .icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 1rem;
    opacity: 0.3;
  }
</style>
