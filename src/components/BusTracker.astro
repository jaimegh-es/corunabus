---
import { getTranslations } from '../utils/i18n';
import Icon from './Icon.astro';

const lang = Astro.cookies.get('buscoruna_lang')?.value || 'es';
const t = getTranslations(lang);
---

<bus-tracker>
  <div class="bustracker card">
    <div class="tracker-head">
      <span class="tracker-head-icon"><Icon name="bus" size={22} /></span>
      <div>
        <h3>{t.trackerTitle}</h3>
        <p class="tracker-sub">{t.trackerSub}</p>
      </div>
    </div>

    <div class="tracker-tabs">
      <button type="button" class="tracker-tab active" data-mode="number">
        <span class="tracker-tab-num">#</span>
        {t.trackerByNumber}
      </button>
      <button type="button" class="tracker-tab" data-mode="location">
        <Icon name="location" size={16} />
        {t.trackerByLocation}
      </button>
    </div>

    <div class="tracker-pane active" id="tracker-pane-number">
      <div class="tracker-row">
        <input type="tel" inputmode="numeric" id="tracker-bus-number" placeholder={t.trackerNumberPlaceholder} />
      </div>
      <div class="tracker-row">
        <button type="button" id="tracker-number-btn" class="btn-primary tracker-full-btn">{t.trackerDetectBtn}</button>
      </div>
    </div>

    <div class="tracker-pane" id="tracker-pane-location">
      <button type="button" id="tracker-location-btn" class="btn-secondary tracker-locate-btn">
        <Icon name="location" size={16} />
        {t.trackerLocateBtn}
      </button>
    </div>

    <div id="tracker-status"></div>
    <div id="tracker-result"></div>
  </div>
</bus-tracker>

<style is:global>
  bus-tracker {
    display: block;
    width: 100%;
  }

  bus-tracker .bustracker {
    margin-bottom: 2rem;
  }

  bus-tracker .tracker-head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  bus-tracker .tracker-head h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  bus-tracker .tracker-head-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary);
    color: white;
    border-radius: 12px;
  }

  bus-tracker .tracker-sub {
    margin: 0.25rem 0 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  bus-tracker .tracker-tabs {
    display: flex;
    gap: 0.5rem;
    margin: 1rem 0 0.75rem;
  }

  bus-tracker .tracker-tab {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.55rem 0.5rem;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s;
  }

  bus-tracker .tracker-tab.active {
    background: #eff6ff;
    border-color: var(--primary);
    color: var(--primary);
  }

  bus-tracker .tracker-tab-num {
    font-weight: 800;
    font-size: 0.9rem;
  }

  bus-tracker .tracker-pane {
    display: none;
  }

  bus-tracker .tracker-pane.active {
    display: block;
  }

  bus-tracker .tracker-row {
    display: flex;
    gap: 0.5rem;
  }

  bus-tracker .tracker-row + .tracker-row {
    margin-top: 0.5rem;
  }

  bus-tracker .tracker-row input {
    flex: 1;
    min-width: 0;
    width: 100%;
    padding: 0.75rem 0.85rem;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font-size: 1rem;
    background: #fff;
  }

  bus-tracker .tracker-row input:focus {
    outline: none;
    border-color: var(--primary);
  }

  bus-tracker .tracker-full-btn {
    width: 100%;
  }

  bus-tracker .tracker-locate-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  bus-tracker #tracker-status {
    margin-top: 0.75rem;
  }

  bus-tracker #tracker-status .loading {
    margin: 0.5rem auto;
  }

  bus-tracker .tracker-error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    border-radius: 10px;
    padding: 0.7rem 0.9rem;
    font-size: 0.85rem;
  }

  bus-tracker .tracker-found {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    padding: 0.85rem 1rem;
  }

  bus-tracker .tracker-found-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.95rem;
  }

  bus-tracker .tracker-found .line-badge {
    white-space: nowrap;
  }

  bus-tracker .tracker-found small {
    display: block;
    margin-top: 0.25rem;
    color: var(--text-muted);
  }

  bus-tracker .tracker-dest-title {
    margin: 1rem 0 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  bus-tracker .tracker-dest-note {
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  bus-tracker .tracker-dest-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: min(430px, 60vh);
    overflow-y: auto;
    /* Room for the finger to scroll the list without it grabbing a row. */
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    padding: 2px;
    margin: -2px;
  }

  bus-tracker .tracker-dest-item-wrap {
    display: flex;
    flex-direction: column;
    /* The list is a scrolling column, so every row is a flex item that can be
       squeezed. `overflow: hidden` below drops the automatic min-height, so a
       long list (a line with 40+ stops) shrank every row to a 2px line and the
       buttons inside it were clipped away. Rows keep their height and the list
       scrolls instead. */
    flex-shrink: 0;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
    transition: border-color 0.15s;
  }

  bus-tracker .tracker-dest-item-wrap:has(.tracker-dest-item.open) {
    border-color: #94a3b8;
  }

  /* Stops the bus is not going to serve on this trip: the rest of the line, in
     either direction, plus the ones it has already passed. They stay in the list
     so the line can be read whole, but they are not destinations, so they are
     only quieter, never colour-coded. */
  bus-tracker .tracker-dest-item-wrap.is-rest {
    background: #fff;
    border-color: #eef2f7;
  }

  bus-tracker .tracker-dest-item-wrap.is-rest .tracker-dest-item {
    color: var(--text-muted);
    font-weight: 400;
  }

  bus-tracker .tracker-dest-item-wrap.is-rest .tracker-dest-item:hover {
    background: #f8fafc;
  }

  /* The only marker of "this one the bus is going to serve": a dot. */
  bus-tracker .tracker-dest-dot {
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #d7dee7;
  }

  bus-tracker .tracker-dest-item-wrap.is-ahead .tracker-dest-dot {
    background: #16a34a;
  }

  /* Sized for a thumb: 52px tall rows, comfortable padding and a full-width
     target, so a stop can be picked without aiming. */
  bus-tracker .tracker-dest-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 52px;
    text-align: left;
    padding: 0.8rem 0.9rem;
    border: none;
    background: none;
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--text);
    transition: background 0.15s;
  }

  bus-tracker .tracker-dest-item:hover {
    background: #f8fafc;
  }

  /* No hover on a touchscreen, so the press itself is the feedback. */
  bus-tracker .tracker-dest-item:active {
    background: #eef2f7;
  }

  /* The stop name takes the room that is left and wraps; the countdown beside
     it is nowrap and on a narrow screen would squeeze the name down to an
     unreadable sliver. */
  bus-tracker .tracker-dest-name {
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  bus-tracker .tracker-dest-item small {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  bus-tracker .tracker-dest-caret {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 0.85rem;
    transition: transform 0.2s;
  }

  bus-tracker .tracker-dest-item.open .tracker-dest-caret {
    transform: rotate(180deg);
    color: var(--primary);
  }

  bus-tracker .tracker-dest-actions {
    display: flex;
    flex-shrink: 0;
    gap: 0.5rem;
    padding: 0.75rem 0.9rem;
    border-top: 1px dashed #e2e8f0;
    background: #fafbfc;
  }

  /* The display:flex above beats the [hidden] attribute's UA display:none, so
     every action row was visible at once. Only the stop the user opened should
     show its actions. */
  bus-tracker .tracker-dest-actions[hidden] {
    display: none;
  }

  bus-tracker .tracker-dest-track {
    flex: 1;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border: none;
    border-radius: 10px;
    background: var(--primary);
    color: white;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
  }

  bus-tracker .tracker-dest-track:active {
    transform: scale(0.97);
  }

  bus-tracker .tracker-dest-view {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #fff;
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  /* Narrow screens: side by side the countdown squeezes the stop name to a
     couple of characters, so it drops to its own line under the name, and the
     two actions stack instead of fighting for the width. */
  @media (max-width: 420px) {
    bus-tracker .tracker-dest-item {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      column-gap: 0.5rem;
      row-gap: 0.15rem;
    }

    bus-tracker .tracker-dest-dot {
      grid-area: 1 / 1;
    }

    bus-tracker .tracker-dest-name {
      grid-area: 1 / 2;
    }

    bus-tracker .tracker-dest-item small {
      grid-area: 2 / 1 / 3 / 4;
    }

    bus-tracker .tracker-dest-caret {
      grid-area: 1 / 3;
      justify-self: end;
    }

    bus-tracker .tracker-dest-actions {
      flex-wrap: wrap;
    }

    bus-tracker .tracker-dest-track,
    bus-tracker .tracker-dest-view {
      flex: 1 1 100%;
      justify-content: center;
    }
  }

  bus-tracker .tracker-started {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e40af;
    border-radius: 12px;
    padding: 0.85rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  bus-tracker .tracker-reset {
    margin-top: 0.75rem;
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }
</style>

<script>
  import { storage } from '../utils/storage';
  import { API } from '../services/api';
  import { tracking } from '../utils/tracking';
  import { getPosition } from '../utils/geolocation';
  import { getTranslations } from '../utils/i18n';

  const lang = document.documentElement.getAttribute('data-lang') || 'es';
  const t = getTranslations(lang);

  class BusTracker extends HTMLElement {
    private catalog: any = null;
    private mode: 'number' | 'location' = 'number';
    private userPos: { lat: number; lon: number } | null = null;
    private scanning = false;
    private currentBus: { bus: any; line: any } | null = null;
    private scanCache: { at: number; key: string; entries: any[] } | null = null;
    private SCAN_CACHE_MS = 15000;
    // Bus positions get stale quickly, but for *detection* (which line is bus
    // X on / is a bus near me) several minutes of age is perfectly fine. The
    // live tracking bar uses dedicated arrival/ETA endpoints, not this cache.
    private LINE_MAP_CACHE_MS = 900000;
    private LINE_MAP_CACHE_KEY = 'buscoruna_line_map';
    // Mapping bus number -> line id, learned from previous detections. Lets
    // re-detecting the same bus cost 0-1 requests instead of a full scan.
    // Stored in localStorage (survives reloads) with a long TTL: over time the
    // app "knows" most bus numbers and detection becomes instant.
    private BUS_LINE_CACHE_KEY = 'buscoruna_bus_line';
    private BUS_LINE_CACHE_MS = 24 * 60 * 60 * 1000;
    // lineId -> last time we successfully fetched its live map. Candidate lines
    // are scanned most-recently-active first, which usually means they are still
    // in the map cache and cost 0 requests.
    private LINE_RECENCY_KEY = 'buscoruna_line_recency';
    private LINE_RECENCY_MAX = 100;
    // How close a bus has to be to a stop of a route to be considered "on" it.
    // Beyond this the position is not usable to work out the stops ahead.
    private NEAR_STOP_METERS = 1000;
    private scanAbort = false;

    connectedCallback() {
      this.catalog = storage.getCatalog();
      window.addEventListener('catalog-loaded', () => {
        this.catalog = storage.getCatalog();
      });

      this.setupTabs();
      this.setupNumberSearch();
      this.setupLocationSearch();
    }

    setupTabs() {
      const tabs = this.querySelectorAll('.tracker-tab');
      tabs.forEach(btn => {
        btn.addEventListener('click', () => {
          this.mode = btn.getAttribute('data-mode') as 'number' | 'location';
          // Cancel a scan that may still be running in the other pane so the
          // user is never locked behind it.
          this.scanAbort = true;
          tabs.forEach(b => b.classList.toggle('active', b === btn));
          (this.querySelector('#tracker-pane-number') as HTMLElement).classList.toggle('active', this.mode === 'number');
          (this.querySelector('#tracker-pane-location') as HTMLElement).classList.toggle('active', this.mode === 'location');
          this.setScanButton(false);
          this.showStatus('');
          this.showResult('');
        });
      });
    }

    setupNumberSearch() {
      const input = this.querySelector('#tracker-bus-number') as HTMLInputElement;
      const btn = this.querySelector('#tracker-number-btn') as HTMLButtonElement;

      const run = () => {
        if (this.scanning) {
          // Already scanning: pressing the button again cancels the search so
          // the user is never stuck watching a long scan.
          // Ya está escaneando: volver a pulsar cancela la búsqueda.
          this.scanAbort = true;
          return;
        }
        this.searchByNumber(input.value.trim());
      };
      btn.addEventListener('click', run);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          if (this.scanning) this.scanAbort = true;
          else this.searchByNumber(input.value.trim());
        }
      });
    }

    setupLocationSearch() {
      const btn = this.querySelector('#tracker-location-btn') as HTMLButtonElement;
      btn.addEventListener('click', () => this.searchByLocation());
    }

    async searchByNumber(busNumber: string) {
      if (!busNumber || this.scanning) return;
      this.showStatus(`<div class="loading">${t.trackerScanning}</div>`);
      this.showResult('');
      this.scanning = true;
      this.scanAbort = false;
      this.setScanButton(true);
      try {
        const found = await this.scanLines(busNumber);
        if (this.scanAbort) {
          this.showStatus('');
          this.showResult('');
        } else if (found) {
          this.showDetected(found);
        } else {
          this.showResult(`<div class="tracker-error">${t.trackerNotFound}</div>`);
        }
      } finally {
        this.scanning = false;
        this.scanAbort = false;
        this.setScanButton(false);
      }
    }

    setScanButton(scanning: boolean) {
      const btn = this.querySelector('#tracker-number-btn') as HTMLButtonElement;
      if (btn) btn.textContent = scanning ? t.trackerCancel : t.trackerDetectBtn;
    }

    async searchByLocation() {
      if (this.scanning) return;
      this.showStatus(`<div class="loading">${t.trackerLocating}</div>`);
      this.showResult('');
      this.scanning = true;
      try {
        this.userPos = await this.getUserPosition();
        if (!this.userPos) {
          this.showResult(`<div class="tracker-error">${t.trackerGeoError}</div>`);
          return;
        }
        this.showStatus(`<div class="loading">${t.trackerScanning}</div>`);
        const found = await this.scanLines();
        if (found) {
          this.showDetected(found);
        } else {
          this.showResult(`<div class="tracker-error">${t.trackerNoBusesNear}</div>`);
        }
      } finally {
        this.scanning = false;
      }
    }

    getUserPosition(): Promise<{ lat: number; lon: number } | null> {
      return getPosition({ forceRefresh: true });
    }

    async scanLines(busNumber?: string) {
      const lineIds = await this.candidateLineIds(busNumber);
      if (lineIds.length === 0) {
        this.showStatus('');
        this.showResult(`<div class="tracker-error">${t.trackerNoCatalog}</div>`);
        return null;
      }

      // Check the lines that serve stops near the user first: the bus is very
      // likely close to them, so we often find it before touching most lines.
      // In number mode, additionally put the most-recently-active lines first
      // (they are usually still in the map cache, so checking them costs 0
      // requests and finds the bus much sooner than a big scan).
      const orderedIds = this.orderLinesByProximity(lineIds);
      const scanOrder = busNumber ? this.orderLinesByActivity(orderedIds) : orderedIds;

      // Number mode: if we already learned which line this bus number runs on,
      // just re-check that single line (fresh or cached) instead of rescanning.
      if (busNumber) {
        const knownLineId = this.getBusLineCache(busNumber);
        if (knownLineId) {
          const knownHit = await this.tryLine(knownLineId, busNumber);
          if (knownHit) {
            if (this.scanAbort) return null;
            return { bus: knownHit.bus, line: knownHit.line };
          }
        }

        // Scan in small batches and stop as soon as the bus is found, so we
        // never spend API budget on lines that come after the hit. BATCH matches
        // the upstream token bucket capacity, so the first wave is instant.
        const acc: any[] = [];
        const BATCH = 4;
        for (let i = 0; i < scanOrder.length; i += BATCH) {
          if (this.scanAbort) return null;
          const entries = await this.fetchBusEntries(scanOrder.slice(i, i + BATCH));
          if (this.scanAbort) return null;
          acc.push(...entries);
          const hit = acc.find(e => e.bus.bus && e.bus.bus.toString() === busNumber);
          if (hit) {
            this.setBusLineCache(busNumber, hit.line.id);
            return { bus: hit.bus, line: hit.line };
          }
        }
        return null;
      }

      // Location mode: nearest bus over the full candidate set (reuse a recent
      // scan while the user keeps interacting with the detection).
      const cacheKey = scanOrder.slice().sort((a: number, b: number) => a - b).join(',');
      let entries: any[] = this.scanCache &&
        Date.now() - this.scanCache.at < this.SCAN_CACHE_MS &&
        this.scanCache.key === cacheKey
        ? this.scanCache.entries
        : [];

      if (entries.length === 0) {
        entries = await this.fetchBusEntries(scanOrder);
        this.scanCache = { at: Date.now(), key: cacheKey, entries };
      }

      if (this.userPos) {
        let nearest: { bus: any; line: any; dist: number } | null = null;
        for (const e of entries) {
          const d = this.getDistance(this.userPos.lat, this.userPos.lon, e.bus.posy, e.bus.posx);
          if (!nearest || d < nearest.dist) nearest = { bus: e.bus, line: e.line, dist: d };
        }
        if (nearest && nearest.dist <= 2000) {
          return { bus: nearest.bus, line: nearest.line };
        }
        return null;
      }

      return null;
    }

    // Check a single line for a given bus number (reuses cached map data).
    async tryLine(lineId: number, busNumber: string) {
      const lines = await this.getCatalogLines();
      if (!lines) return null;
      const line = lines.find((l: any) => l && l.id.toString() === lineId.toString());
      if (!line) return null;
      const entries = await this.fetchBusEntries([line.id]);
      const hit = entries.find(e => e.bus.bus && e.bus.bus.toString() === busNumber);
      return hit || null;
    }

    // Put lines that serve stops within 1.5km of the user (if known) first.
    orderLinesByProximity(lineIds: number[]): number[] {
      if (!this.userPos) return lineIds;
      const nearby = this.findNearbyStops(this.userPos.lat, this.userPos.lon, 1500);
      const priority = new Set<number>();
      nearby.forEach((s: any) => {
        (s.enlaces || []).forEach((lid: any) => {
          const id = parseInt(lid.toString(), 10);
          if (!isNaN(id)) priority.add(id);
        });
      });
      return [...lineIds.filter(id => priority.has(id)), ...lineIds.filter(id => !priority.has(id))];
    }

    getBusLineCache(busNumber: string): number | null {
      try {
        const raw = localStorage.getItem(`${this.BUS_LINE_CACHE_KEY}_${busNumber}`);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed.lineId !== 'number' || typeof parsed.at !== 'number') return null;
        if (Date.now() - parsed.at > this.BUS_LINE_CACHE_MS) return null;
        return parsed.lineId;
      } catch {
        return null;
      }
    }

    setBusLineCache(busNumber: string, lineId: number) {
      try {
        localStorage.setItem(`${this.BUS_LINE_CACHE_KEY}_${busNumber}`, JSON.stringify({ lineId, at: Date.now() }));
      } catch {
        // ignore
      }
    }

    // --- Recent line activity -------------------------------------------------
    getLineRecency(): Record<string, number> {
      try {
        const raw = localStorage.getItem(this.LINE_RECENCY_KEY);
        return raw ? JSON.parse(raw) : {};
      } catch {
        return {};
      }
    }

    recordLineActivity(lineId: number) {
      try {
        const rec = this.getLineRecency();
        rec[lineId.toString()] = Date.now();
        const keys = Object.keys(rec).sort((a, b) => rec[b] - rec[a]);
        while (keys.length > this.LINE_RECENCY_MAX) delete rec[keys.pop()!];
        localStorage.setItem(this.LINE_RECENCY_KEY, JSON.stringify(rec));
      } catch {
        // ignore
      }
    }

    // Most recently active lines first (recency stored in localStorage so it
    // survives reloads).
    orderLinesByActivity(ids: number[]): number[] {
      const rec = this.getLineRecency();
      return [...ids].sort((a, b) => (rec[b] || 0) - (rec[a] || 0));
    }

    // Fetch bus positions for a set of lines in parallel (the API queue keeps
    // concurrency bounded), resolving to one entry per bus. Per-line map data is
    // cached for a few minutes so repeated detections reuse it without spending
    // API budget; stale cache is used as fallback when the API is unavailable.
    async fetchBusEntries(lineIds: number[]) {
      const lines = await this.getCatalogLines();
      if (!lines) return [];
      const byId = new Map(lines.map((l: any) => [l.id.toString(), l]));

      const results = await Promise.allSettled(
        lineIds.map(async (id) => {
          const line = byId.get(id.toString());
          if (!line || !line.id) return [] as any[];
          const cacheKey = line.id.toString();
          const cached = this.readLineMapCache(cacheKey);

          let data: any;
          if (cached && Date.now() - cached.at < this.LINE_MAP_CACHE_MS) {
            data = cached.data;
          } else {
            try {
              data = await API.getMapData(line.id, 'B');
              if (data && data.resultado === 'OK') {
                this.writeLineMapCache(cacheKey, data);
              }
            } catch (err) {
              data = cached ? cached.data : null;
            }
          }

          if (!data || data.resultado !== 'OK' || !data.mapas || !data.mapas[0] || !Array.isArray(data.mapas[0].buses)) return [] as any[];
          this.recordLineActivity(line.id);
          const entries: any[] = [];
          for (const dir of data.mapas[0].buses) {
            for (const b of dir.buses || []) {
              entries.push({ bus: { ...b, sentido: dir.sentido }, line });
            }
          }
          return entries;
        })
      );

      return results.flatMap(r => (r.status === 'fulfilled' ? r.value : []));
    }

    readLineMapCache(id: string): { at: number; data: any } | null {
      try {
        const raw = sessionStorage.getItem(`${this.LINE_MAP_CACHE_KEY}_${id}`);
        return raw ? JSON.parse(raw) : null;
      } catch {
        return null;
      }
    }

    writeLineMapCache(id: string, data: any) {
      try {
        sessionStorage.setItem(`${this.LINE_MAP_CACHE_KEY}_${id}`, JSON.stringify({ at: Date.now(), data }));
      } catch {
        // storage full/unavailable - ignore
      }
    }

    // Number mode: scan all lines. Location mode: narrow down to the lines that
    // serve the stops closest to the user, which is a fraction of all lines.
    async candidateLineIds(busNumber?: string): Promise<number[]> {
      const lines = await this.getCatalogLines();
      if (!lines) return [];
      const allIds = lines.filter((l: any) => l && l.id).map((l: any) => l.id);

      if (busNumber || !this.userPos) return allIds;

      const nearby = this.findNearbyStops(this.userPos.lat, this.userPos.lon, 1500);
      const set = new Set<number>();
      nearby.forEach((s: any) => {
        (s.enlaces || []).forEach((lid: any) => {
          const id = parseInt(lid.toString(), 10);
          if (!isNaN(id)) set.add(id);
        });
      });
      const candidates = [...set];
      return candidates.length > 0 ? candidates : allIds;
    }

    async getCatalogLines() {
      this.catalog = storage.getCatalog();
      if (!this.catalog || !this.catalog.actualizacion || !this.catalog.actualizacion.lineas) return null;
      return this.catalog.actualizacion.lineas;
    }

    findNearbyStops(lat: number, lon: number, radiusMeters: number) {
      this.catalog = storage.getCatalog();
      if (!this.catalog || !this.catalog.paradas) return [];
      return Object.values(this.catalog.paradas)
        .map((s: any) => ({ ...s, dist: this.getDistance(lat, lon, s.posy, s.posx) }))
        .filter((s: any) => s.dist <= radiusMeters)
        .sort((a: any, b: any) => a.dist - b.dist);
    }

    showDetected(found: { bus: any; line: any }) {
      const routeInfo = this.resolveRoute(found.bus, found.line);
      if (!routeInfo) {
        this.showResult(`<div class="tracker-error">${t.trackerNotFound}</div>`);
        return;
      }

      const lineComer = found.line.lin_comer || found.line.id;
      // The upstream map feed (func=99) sends no `destino`, so the header used to
      // render "hacia " with nothing after it. The direction of travel is known
      // anyway: it is the route the bus is running, whose last stop is the
      // terminus of that direction.
      const destName = found.bus.destino || routeInfo.destName || '';
      this.currentBus = found;

      // The line read whole: every stop it serves, in both directions, so the
      // list can be scanned for the stop the user is after. The stops still
      // ahead of the bus in the direction it is travelling are the ones marked
      // with the remaining time, and the only ones that can be tracked to.
      const ahead = routeInfo.stopsAhead;
      const aheadAt = new Map(ahead.map((pid: any, i: number) => [String(pid), i + 1]));
      const items = routeInfo.lineStops.map((pid: any) => {
        const stop = this.catalog.paradas?.[pid];
        if (!stop) return '';
        const remaining = aheadAt.get(String(pid));
        const isAhead = remaining !== undefined;
        const name = this.escapeHtml(stop.nombre || String(pid));
        // Only the stops ahead carry a countdown. The rest are listed plainly:
        // the note above the list already says which ones the bus will serve.
        const eta = isAhead
          ? `<small>${t.trackerDestRemaining
              .replace('{m}', remaining.toString())
              .replace('{min}', Math.round(remaining * 2).toString())}</small>`
          : '';
        return `
          <div class="tracker-dest-item-wrap ${isAhead ? 'is-ahead' : 'is-rest'}">
            <button type="button" class="tracker-dest-item" data-stop-id="${pid}">
              <span class="tracker-dest-dot" aria-hidden="true"></span>
              <span class="tracker-dest-name">${name}</span>
              ${eta}
              <span class="tracker-dest-caret" aria-hidden="true">▾</span>
            </button>
            <div class="tracker-dest-actions" data-stop-id="${pid}" hidden>
              ${isAhead ? `<button type="button" class="tracker-dest-track" data-stop-id="${pid}">${t.trackerDestTrack}</button>` : ''}
              <a href="/stop/${pid}" class="tracker-dest-view">${lang === 'en' ? 'View stop' : 'Ver parada'}</a>
            </div>
          </div>
        `;
      }).join('');

      const note = !routeInfo.positionKnown
        ? t.trackerPositionUnknown
        : routeInfo.stopsAhead.length === 0
          ? t.trackerNoStopsAhead
          : t.trackerFullLine;

      this.showStatus('');
      this.showResult(`
        <div class="tracker-found">
          <div class="tracker-found-header">
            <span class="line-badge" style="background-color: #${found.line.color || 'f44336'}">${lineComer}</span>
            <span>${t.trackerFoundBus
              .replace('{num}', found.bus.bus)
              .replace('{line}', lineComer)
              .replace('{dest}', destName)}</span>
          </div>
          <small>${routeInfo.nearestStop ? `${t.trackerNearStop} <strong>${this.escapeHtml(routeInfo.nearestStop.nombre || '')}</strong>` : ''}</small>
        </div>
        ${items
          ? `<div class="tracker-dest-title">${t.trackerSelectDest}</div>
             <p class="tracker-dest-note">${note}</p>
             <div class="tracker-dest-list">${items}</div>`
          : `<div class="tracker-error">${t.trackerNoStopsAhead}</div>
             <button type="button" class="tracker-reset" id="tracker-reset-btn">${t.trackerCancel}</button>`}
      `);

      this.querySelectorAll('.tracker-dest-item').forEach(btn => {
        btn.addEventListener('click', () => {
          this.toggleDestActions(btn);
        });
      });

      // The line is listed whole, so the first stop still ahead of the bus can
      // sit well below the fold, after every stop it has already passed. Start
      // the scroll there: that is where the choices the bus can serve begin.
      const list = this.querySelector('.tracker-dest-list');
      const firstAhead = list?.querySelector('.tracker-dest-item-wrap.is-ahead');
      if (list && firstAhead && firstAhead.offsetTop !== undefined) {
        list.scrollTop = Math.max(0, firstAhead.offsetTop - list.offsetTop - 4);
      }

      this.querySelectorAll('.tracker-dest-track').forEach(btn => {
        btn.addEventListener('click', () => {
          this.startTracking(routeInfo, btn.getAttribute('data-stop-id')!);
        });
      });

      this.querySelector('#tracker-reset-btn')?.addEventListener('click', () => {
        this.currentBus = null;
        this.showResult('');
        this.showStatus('');
      });
    }

    // Stop names and line colours come from an external feed, so they are escaped
    // before being interpolated into innerHTML.
    // Los nombres de parada vienen de un feed externo: se escapan antes de
    // inyectarlos en el HTML.
    escapeHtml(value: string) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Resolve which route the bus is running and which stops are still ahead.
    //
    // The live feed (func=99) reports each bus under `sentido`, the direction it
    // is travelling in, which matches the index of that direction in `line.rutas`.
    // That direction - not "whichever route has the most stops left" - is what
    // decides the destination list: picking by position alone returned the
    // opposite direction for about half of the live buses, because a route and
    // its return share the same streets and stops, so a bus sitting on a shared
    // stretch was just as close to the reverse route.
    // Resolver en qué ruta va el bus y qué paradas le quedan por delante.
    resolveRoute(bus: any, line: any) {
      const routes: any[] = Array.isArray(line?.rutas) ? line.rutas.filter(r => r && Array.isArray(r.paradas) && r.paradas.length >= 2) : [];
      if (routes.length === 0) return null;

      // Only the routes that run in the direction the bus is travelling, keeping
      // their catalog order so `sentido` indexes into it.
      const sentido = parseInt(bus?.sentido, 10);
      const direction = !isNaN(sentido) && sentido >= 0 && sentido < routes.length
        ? routes.filter(r => this.sameDirection(r, routes[sentido]))
        : routes;

      // A line can run variants of the same direction through different streets.
      // The bus is on the one it is physically closest to; the number of stops
      // left only breaks ties between routes that share that stretch.
      let best: any = null;
      for (let di = 0; di < direction.length; di++) {
        const route = direction[di];
        const nearest = this.nearestStopIndex(bus, route);
        // A bus whose GPS fix is missing, or one too far from any stop of this
        // route, tells us nothing about where it is on the route. Without a
        // position we cannot tell which stops it has already passed, so the
        // whole route is listed: showing every stop beats showing none.
        if (!nearest || nearest.idx === -1 || nearest.dist > this.NEAR_STOP_METERS) continue;

        const remaining = route.paradas.length - 1 - nearest.idx;
        if (!best || nearest.dist < best.minDist || (nearest.dist === best.minDist && remaining > best.remaining)) {
          best = { route, di, nearestIdx: nearest.idx, minDist: nearest.dist, remaining };
        }
      }

      if (!best) {
        const route = direction[0];
        return this.finalizeRoute({ route, di: 0, nearestIdx: -1, minDist: Infinity, remaining: route.paradas.length }, routes);
      }
      return this.finalizeRoute(best, routes);
    }

    // Two routes run in the same direction when they start and end at the same
    // stops (a line with variants has one route per variant, all sharing the
    // direction of the first one).
    sameDirection(a: any, b: any) {
      return a.paradas[0] === b.paradas[0] &&
             a.paradas[a.paradas.length - 1] === b.paradas[b.paradas.length - 1];
    }

    // Index of the stop on this route that the bus is closest to. Stops without
    // coordinates or a bus without a usable position are ignored.
    nearestStopIndex(bus: any, route: any) {
      const lat = Number(bus?.posy);
      const lon = Number(bus?.posx);
      // Number(null) and Number("") are 0, which is a real (if unlikely) point in
      // the ocean, so the raw values have to be checked too.
      if (bus?.posy === null || bus?.posy === undefined || bus.posy === '' ||
          bus?.posx === null || bus?.posx === undefined || bus.posx === '' ||
          !Number.isFinite(lat) || !Number.isFinite(lon)) {
        return null;
      }
      const paradasById = this.catalog?.paradas || {};
      let idx = -1;
      let dist = Infinity;
      route.paradas.forEach((pid: any, i: number) => {
        const s = paradasById[pid];
        if (!s) return;
        const d = this.getDistance(Number(bus.posy), Number(bus.posx), Number(s.posy), Number(s.posx));
        if (d < dist) { dist = d; idx = i; }
      });
      return { idx, dist };
    }

    finalizeRoute(info: any, allRoutes: any[]) {
      const paradasById = this.catalog?.paradas || {};
      const paradas = info.route.paradas;
      const nearestStop = info.nearestIdx >= 0 ? paradasById[paradas[info.nearestIdx]] : null;
      const lastStop = paradasById[paradas[paradas.length - 1]];
      // Everything after the stop the bus is closest to. Only meaningful when the
      // bus position is known (nearestIdx >= 0): otherwise nothing is known to
      // be ahead of it, so no stop is offered as a destination.
      const stopsAhead = info.nearestIdx >= 0 ? paradas.slice(info.nearestIdx + 1) : [];
      return {
        ...info,
        nearestStop,
        stopsAhead,
        positionKnown: info.nearestIdx >= 0,
        // The line read whole: every stop it serves, both directions and every
        // variant, in catalog order and without repeats. The bus' own direction
        // is what tells which of them are still ahead.
        lineStops: this.lineStopList(allRoutes),
        destName: lastStop?.nombre || '',
      };
    }

    // Every stop a line serves, in catalog order, de-duplicated. Walks all the
    // routes, not just the one the bus is running, so the list covers the whole
    // line instead of a single direction.
    lineStopList(routes: any[]) {
      const seen = new Set<string>();
      const list: any[] = [];
      for (const route of routes) {
        if (!Array.isArray(route?.paradas)) continue;
        for (const pid of route.paradas) {
          const key = String(pid);
          if (seen.has(key)) continue;
          seen.add(key);
          list.push(pid);
        }
      }
      return list;
    }

    toggleDestActions(btn: HTMLElement) {
      const wrap = btn.closest('.tracker-dest-item-wrap');
      const actions = wrap?.querySelector('.tracker-dest-actions');
      if (!actions) return;
      const willOpen = actions.hasAttribute('hidden');

      this.querySelectorAll('.tracker-dest-actions').forEach(a => a.setAttribute('hidden', ''));
      this.querySelectorAll('.tracker-dest-item').forEach(el => el.classList.remove('open'));

      if (willOpen) {
        actions.removeAttribute('hidden');
        btn.classList.add('open');
      }
    }

    startTracking(routeInfo: any, stopId: string) {
      const destId = parseInt(stopId);
      // The bus has no known position on the route (nearestIdx -1) when its GPS
      // fix is missing, so there is no meaningful origin stop to start from.
      const originId = routeInfo.nearestIdx >= 0
        ? parseInt(routeInfo.route.paradas[routeInfo.nearestIdx])
        : NaN;
      const bus = this.currentBus?.bus;

      if (!bus || isNaN(destId) || isNaN(originId)) return;

      tracking.set({
        busId: bus.bus.toString(),
        lineId: this.currentBus.line.id,
        destinationStopId: destId,
        originStopId: originId,
        lastEta: null,
        arrivalTime: null
      });

      this.showStatus('');
      this.showResult(`
        <div class="tracker-started">
          <span>✅</span> ${t.trackerStarted}
        </div>
        <button type="button" class="tracker-reset" id="tracker-reset-btn">${t.trackerCancel}</button>
      `);
      this.querySelector('#tracker-reset-btn')?.addEventListener('click', () => {
        this.currentBus = null;
        this.showResult('');
        this.showStatus('');
      });
    }

    getDistance(lat1: number, lon1: number, lat2: number, lon2: number) {
      const R = 6371000;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    showStatus(html: string) {
      const el = this.querySelector('#tracker-status');
      if (el) el.innerHTML = html;
    }

    showResult(html: string) {
      const el = this.querySelector('#tracker-result');
      if (el) el.innerHTML = html;
    }
  }

  customElements.define('bus-tracker', BusTracker);
</script>